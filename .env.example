# Šablona lokálního .env — zkopírovat na `.env` (ten je v .gitignore) a doplnit.
# Komentáře pod články (giscus / GitHub Discussions), postup: docs/giscus.md
#
# Hodnoty nejsou tajné (jsou v HTML každého článku), ale do repa nepatří —
# sem jen placeholdery. Skutečná ID vygeneruje https://giscus.app.
# Bez PUBLIC_GISCUS_REPO_ID a PUBLIC_GISCUS_CATEGORY_ID se sekce Komentáře
# vůbec nevykreslí.

# Repozitář s Discussions (výchozí hodnota, když proměnná chybí)
PUBLIC_GISCUS_REPO=denyappbuilder/realtech-web

# data-repo-id z giscus.app
PUBLIC_GISCUS_REPO_ID=R_kgDO…

# Kategorie Discussions — živě je to Announcements (vlákna zakládá jen giscus app)
PUBLIC_GISCUS_CATEGORY=Announcements

# data-category-id z giscus.app
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDO…
