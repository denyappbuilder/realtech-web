---
/*
 * Fonty jen latin + latin-ext — víc čeština nepotřebuje. Kombinované
 * entrypointy (`400.css`) deklarovaly i cyrilici, řečtinu a vietnamštinu:
 * 31 @font-face v produkčním CSS. Díky unicode-range se sice nestahovaly,
 * ale zbytečně nafukovaly kritické CSS. Archivo subsetové entrypointy nemá,
 * `wdth.css` = latin + latin-ext + vietnamese (ta se nikdy nestáhne).
 * Latin-ext před latin: zachovává pořadí (a tím prioritu překrývajících se
 * unicode-range) z původních kombinovaných souborů.
 * Sans 600 zůstává — global.css ho používá na tlačítkách a CTA
 * (.yt-btn, .hero-cta, .nl-form button, .share-btn…), ne jen v nadpisech.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-500.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

import { getCollection } from 'astro:content';
import { slugify } from '../lib/slugify.js';
import { popisProVyhledavace } from '../lib/popis-pro-vyhledavace.js';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  /**
   * Jde do `<title>`. U článků sem patří CELÝ redakční titulek (nebo ruční
   * `seoTitle`) — Google si zobrazení zkrátí sám, ale titulek useknutý
   * výpustkou už napravit nejde a propadne i do sociálních náhledů.
   */
  title: string;
  /**
   * Plný nadpis pro sociální náhledy. Ty snesou víc než výsledky
   * vyhledávání, takže tady o informaci přicházet nemusíme.
   * Nevyplněno = použije se `title`.
   */
  ogTitle?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** Direktivy pro roboty; velké náhledy obrázků jsou povolené ve výchozím stavu. */
  robots?: string;
  /** Vypni u chybových stránek, ať se neexistující URL nekanonizují na /404. */
  includeCanonical?: boolean;
}

const vsechnyClanky = await getCollection('clanky', ({ data }) => !data.draft);
const temata = [...new Set(vsechnyClanky.map((c) => c.data.category))];
const {
  title,
  ogTitle,
  description = 'Tech novinky a analýzy bez marketingových řečí. Web YouTube kanálu REALTECH CZ.',
  image = '/og-default.jpg',
  ogType = 'website',
  robots = 'max-image-preview:large',
  includeCanonical = true,
} = Astro.props;
const YT = 'https://www.youtube.com/@realtech-cz';
const YT_SUB = 'https://www.youtube.com/@realtech-cz?sub_confirmation=1';
/**
 * Náš vlastní nástroj. Do 29. 7. 2026 na něj z realtech.cz nevedl JEDINÝ odkaz
 * (změřeno: 66 odkazů na homepage, z toho 0 na realtvorbu) — přitom je to při
 * software-first strategii hlavní trychtýř a waitlist za 11 dní posbíral
 * 1 zápis. Web se 45 články o produktu nemluvil vůbec.
 */
const RTV = 'https://realtvorba.cz/';
const path = Astro.url.pathname;
const current = (href: string) =>
  (href === '/' ? path === '/' : path === href || path.startsWith(href)) ? 'page' : undefined;
const socialniTitulek = ogTitle ?? title;
/*
 * Popis pro vyhledávače a náhledy na sítích. Řeže se PO VĚTÁCH na 160 znaků —
 * viz `popis-pro-vyhledavace.js`. Původní `description` zůstává nedotčený
 * a používá se dál jako perex na kartách článků.
 */
const popisSeo = popisProVyhledavace(description);
const canonical = includeCanonical
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = new URL(image, Astro.site);
// YouTube náhledy jsou 1280x720, naše vlastní OG grafika 1200x630
const ogSize = ogImage.hostname.endsWith('ytimg.com')
  ? { w: '1280', h: '720' }
  : { w: '1200', h: '630' };
---
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <script is:inline>
    try {
      var t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/*
    Preconnect na third-party originy, které stránky reálně brzdí: YouTube
    náhledy (homepage jich tahá 5+), mp3 audio přehledy a Cloudflare beacon.
    Vše bez `crossorigin` — img, <audio> bez crossorigin atributu i klasický
    <script> jsou no-CORS requesty a CORS-ové spojení by se nepoužilo.
  */}
  <link rel="preconnect" href="https://i.ytimg.com" />
  <link rel="preconnect" href="https://audio.realtech.cz" />
  <link rel="preconnect" href="https://static.cloudflareinsights.com" />
  <title>{title}</title>
  <meta name="description" content={popisSeo} />
  <meta name="robots" content={robots} />
  {includeCanonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={socialniTitulek} />
  <meta property="og:description" content={popisSeo} />
  <meta property="og:type" content={ogType} />
  {includeCanonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={ogSize.w} />
  <meta property="og:image:height" content={ogSize.h} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="REALTECH CZ" />
  <meta property="og:locale" content="cs_CZ" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={socialniTitulek} />
  <meta name="twitter:description" content={popisSeo} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />
  <meta name="theme-color" content="#F6F7F9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1216" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="REALTECH CZ" href="/rss.xml" />
  <slot name="head" />
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c2d8811d709646ad986cb0e671b8ffd6"}'></script>
</head>
<body>

<a class="skip-link" href="#obsah">Přeskočit na obsah</a>
<SearchModal />

<header class="site">
  <div class="wrap">
    <a href="/" class="logo" aria-label="REALTECHCZ — domů">
      <span class="real">REAL</span><span class="tech">TECH</span><span class="cz">CZ</span>
    </a>
    <nav class="main" aria-label="Hlavní navigace">
      <ul>
        <li><a href="/" aria-current={current('/')}>Novinky</a></li>
        <li><a href="/clanky/" aria-current={current('/clanky/')}>Články</a></li>
        <li><a href="/temata/" aria-current={current('/temata/')}>Témata</a></li>
        <li><a href={YT}>Videa</a></li>
        <li><a href="/o-nas/" aria-current={current('/o-nas/')}>O nás</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <button class="search-trigger" data-search-open aria-label="Hledat v článcích (⌘K)" title="Hledat (⌘K)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 10 3zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z"/></svg>
        <kbd class="st-kbd">⌘K</kbd>
      </button>
      <button id="theme-toggle" class="theme-toggle" aria-label="Přepnout světlý/tmavý režim" title="Světlý/tmavý režim">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.4"/><path d="M12 2v2.6M12 19.4V22M2 12h2.6M19.4 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <a href={YT_SUB} class="yt-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
        Odebírat
      </a>
    </div>
  </div>
</header>

<main id="obsah">
  <slot />
</main>

<section class="newsletter" id="newsletter">
  <div class="wrap">
    <div>
      <span class="mono">// Newsletter</span>
      <h2>Tech bez marketingových řečí.<br />Přímo do mailu.</h2>
      <p>Nejdůležitější novinky a analýzy z AI a techu — česky, stručně a jen když je co říct. Žádný spam.</p>
    </div>
    <div>
      <form class="nl-form" action="https://app.kit.com/forms/9640609/subscriptions" method="post">
        <input type="email" name="email_address" placeholder="tvuj@email.cz" required aria-label="Tvůj e-mail" />
        <button type="submit">Odebírat</button>
      </form>
      <p class="nl-note" data-nl-note>Potvrzení ti přijde e-mailem. Newsletter posíláme přes Kit. Odhlášení jedním klikem. <a href={YT_SUB}>Radši YouTube? →</a></p>
    </div>
  </div>
</section>

<footer class="site">
  <div class="wrap f-top">
    <div class="f-brand">
      <a href="/" class="logo" aria-label="REALTECHCZ — domů">
        <span class="real">REAL</span><span class="tech">TECH</span><span class="cz">CZ</span>
      </a>
      <p class="f-tag">Tech bez marketingových řečí. Novinky a analýzy z AI a techu — česky.</p>
    </div>
    <nav aria-label="Patička" class="f-nav">
      <div>
        <span class="mono f-nav-head">Web</span>
        <ul>
          <li><a href={YT}>YouTube</a></li>
          <li><a href="/clanky/">Články</a></li>
          <li><a href="/temata/">Témata</a></li>
          <li><a href="/o-nas/">O nás</a></li>
          <li><a href="mailto:info@realtech.cz">Kontakt</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          {/* Náš nástroj — jediná cesta z obsahu k produktu, viz komentář u RTV. */}
          <li><a href={RTV}>RealTvorba</a></li>
        </ul>
      </div>
      <div>
        <span class="mono f-nav-head">Témata</span>
        <ul>
          {temata.map((t) => <li><a href={`/temata/${slugify(t)}/`}>{t}</a></li>)}
        </ul>
      </div>
    </nav>
  </div>
  <div class="wrap f-bottom">
    <span class="mono">© {new Date().getFullYear()} REALTECH CZ — Daniel &amp; Sam</span>
    <span class="mono"><span class="live-dot"></span>NOVINKY Z AI A TECHU</span>
  </div>
</footer>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const effective = root.dataset.theme
      || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = effective === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const nlForm = document.querySelector<HTMLFormElement>('.nl-form');
  nlForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = nlForm.querySelector('button')!;
    btn.disabled = true;
    btn.textContent = 'Odesílám…';
    try {
      const res = await fetch(nlForm.action, {
        method: 'POST',
        body: new FormData(nlForm),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      nlForm.innerHTML = '<p class="nl-done">✓ Skoro hotovo — mrkni do mailu a potvrď odběr.</p>';
    } catch {
      nlForm.submit();
    }
  });
</script>

</body>
</html>
