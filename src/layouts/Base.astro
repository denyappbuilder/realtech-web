---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: string;
}
const {
  title,
  description = 'Tech novinky a analýzy bez marketingových řečí. Web YouTube kanálu REALTECH CZ.',
  image = '/og-default.jpg',
  ogType = 'website',
} = Astro.props;
const YT = 'https://www.youtube.com/@realtech-cz';
const YT_SUB = 'https://www.youtube.com/@realtech-cz?sub_confirmation=1';
const path = Astro.url.pathname;
const current = (href: string) =>
  (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`)) ? 'page' : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="REALTECH CZ" />
  <meta property="og:locale" content="cs_CZ" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0d0707" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="REALTECH CZ" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://i.ytimg.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>

<a class="skip-link" href="#obsah">Přeskočit na obsah</a>

<div class="topbar">
  <div class="wrap">
    <span><span class="live-dot"></span>NOVÉ VIDEO KAŽDÝ TÝDEN</span>
    <span>REALTECH REPORT — TECH BEZ MARKETINGOVÝCH ŘEČÍ</span>
  </div>
</div>

<header class="site">
  <div class="wrap">
    <a href="/" class="logo" aria-label="REALTECH CZ — domů">
      <span class="real">REAL</span><span class="tech">TECH</span><span class="cz">CZ</span>
    </a>
    <nav class="main" aria-label="Hlavní navigace">
      <ul>
        <li><a href="/" aria-current={current('/')}>Novinky</a></li>
        <li><a href="/clanky" aria-current={current('/clanky')}>Články</a></li>
        <li><a href={YT}>Videa</a></li>
        <li><a href="/o-nas" aria-current={current('/o-nas')}>O nás</a></li>
      </ul>
    </nav>
    <a href={YT_SUB} class="yt-btn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
      Odebírat
    </a>
  </div>
</header>

<main id="obsah">
  <slot />
</main>

<section class="newsletter">
  <div class="wrap">
    <div>
      <span class="mono">// YouTube</span>
      <h2>Nové video každý týden.<br />Ať ti nic neuteče.</h2>
      <p>Odebírej REALTECH CZ na YouTube — tech novinky a analýzy bez marketingových řečí.</p>
    </div>
    <div>
      <a href={YT_SUB} class="nl-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
        Odebírat na YouTube
      </a>
      <p class="nl-note">Zdarma, jedním kliknutím. Zvoneček navrch, ať ti nové video nepropadne.</p>
    </div>
  </div>
</section>

<footer class="site">
  <div class="wrap">
    <span class="mono">© {new Date().getFullYear()} REALTECH CZ — Daniel &amp; Sam</span>
    <ul>
      <li><a href={YT}>YouTube</a></li>
      <li><a href="/clanky">Články</a></li>
      <li><a href="/o-nas">O nás</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

</body>
</html>
