---
import { audioPrehledPohled } from '../lib/audio-prehled.js';
import { formatVelikost, velikostAudia } from '../lib/audio-velikost.js';

interface Props {
  audio?: {
    url: string;
    duration: string | number;
    transcript?: string;
    ttsScript?: string;
  };
}

const pohled = audioPrehledPohled(Astro.props.audio, Astro.site);
// Kolo 45: skutečná velikost souboru (HEAD při buildu, audio-velikost.js).
// Bez sítě / po timeoutu undefined — řada se vykreslí bez čísla.
const velikostText = pohled ? formatVelikost(await velikostAudia(pohled.src)) : undefined;
---
{pohled && (
  <section class="audio-prehled" aria-labelledby="audio-prehled-nadpis">
    <div class="audio-prehled-head">
      <h2 id="audio-prehled-nadpis">Audio přehled</h2>
      {/* Kolo 36: mezi „Délka“ a <time> musí být skutečný textový uzel —
          kompilátor mezeru mezi elementy vyhodil a čtečka četla „Délka17:42“
          (živě 10. 9. 2026). Vizuální odstup drží margin-right .mono. */}
      <p class="audio-prehled-delka">
        <span class="mono">Délka</span>{' '}
        <time datetime={pohled.iso}>{pohled.delkaText}</time>
      </p>
    </div>
    {/* Kolo 36: „ČTENÍ 4 MIN“ v hlavě článku vs. „Délka 17:42“ tady vypadalo
        jako chyba. Popisek říká, že Deep Dive je celý rozbor (delší než čtení),
        krátký přehled jen to hlavní — text volí audioPrehledPohled podle
        souboru (-nlm.mp3). Je i popisem přehrávače pro čtečku. */}
    <p class="audio-prehled-popis" id="audio-prehled-popis">{pohled.popis}</p>
    {/* Kolo 36: preload="metadata" — nativní ovládání ukáže délku hned
        (jen hlavička souboru), zatímco none ji nechávalo prázdnou do kliknutí.
        auto ne: tahalo by celý 17minutový MP3 každému čtenáři. */}
    <audio controls preload="metadata" src={pohled.src} aria-label="Audio přehled článku" aria-describedby="audio-prehled-popis">
      <a href={pohled.src}>Stáhnout audio přehled</a>
    </audio>
    {/* Kolo 44: Deep Dive má ~25 minut a ~24 MB — odkaz ke stažení byl jen
        fallback uvnitř <audio>, který moderní prohlížeč nikdy nevykreslí.
        Viditelná řada pod přehrávačem: stáhnout MP3 (na cestu, offline)
        a věta, že přehrávač jen streamuje. Soubor je na audio.realtech.cz
        (jiný origin), `download` tam prohlížeč nemusí ctít — odkaz se proto
        otvírá na nové kartě, ať čtenář nepřijde o článek. Žádná kratší
        verze se nevymýšlí (kolo 36).
        Kolo 45: hned za odkazem skutečná velikost souboru (Content-Length
        z R2 při buildu) — Deep Dive má 21–31 MB a čtenář to před klikem
        neviděl. Žádný odhad: bez změřené hodnoty se číslo nevykreslí. */}
    <p class="audio-prehled-akce">
      <a class="audio-prehled-stahnout" href={pohled.src} download target="_blank" rel="noopener">Stáhnout MP3 <span aria-hidden="true">↓</span></a>
      {velikostText && <span class="audio-prehled-velikost">{velikostText}</span>}
      <span class="audio-prehled-akce-note">{pohled.delkaText} na poslech offline. Přehrávač jen streamuje, celý soubor stáhne až tenhle odkaz.</span>
    </p>
    {pohled.prepis && (
      <details class="audio-prehled-prepis">
        <summary>Přepis</summary>
        <p>{pohled.prepis}</p>
      </details>
    )}
  </section>
)}
