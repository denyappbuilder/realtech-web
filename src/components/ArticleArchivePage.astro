---
import { getCollection } from 'astro:content';
import { compareArticlesByDateDescThenId } from '../lib/article-order.js';
import { ARTICLES_PER_PAGE } from '../lib/pagination.js';
import { KARTA_SIZES, nahledKarty } from '../lib/karta-nahled.js';
import { youtubeId } from '../lib/youtube.js';
import { preloadHeroObrazku } from '../lib/hero-preload.js';
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { ogObrazekClanku } from '../lib/og-vypis.js';

interface Props {
  page: number;
}

const { page } = Astro.props;
const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort(compareArticlesByDateDescThenId);
const totalPages = Math.ceil(all.length / ARTICLES_PER_PAGE);
const start = (page - 1) * ARTICLES_PER_PAGE;
const articles = all.slice(start, start + ARTICLES_PER_PAGE);
const categories = [...new Set(all.map((article) => article.data.category))];
const pagePath = (pageNumber: number) => pageNumber === 1 ? '/clanky/' : `/clanky/strana/${pageNumber}/`;

// LCP na /clanky/ je náhled první karty (eager + fetchpriority=high jen
// index 0 na straně 1), ostatní karty jsou lazy. Kolo 20 dalo eager celé
// první řadě (index < 3), ať 2./3. karta na desktopu nesoutěží jako lazy
// LCP — jenže tři eager náhledy najednou soupeřily o pásmo s tím jediným
// preloadovaným (živě 5. 9. 2026), a lazy s Chrome thresholdem 1250px
// nad foldem stejně startuje hned. Preload v <head> míří na první kartu
// a nese imagesrcset/imagesizes = srcset/sizes <source> karty: bez nich
// preload stáhl -640.webp a karta si na DPR>1 vybrala plný .webp (kolo 21).
// Kolo 23: první karta je LCP i na /clanky/strana/2+ (bez filtru sedí
// ještě výš než na straně 1) — eager + high dostává na každé straně,
// stejně jako featured karta tématu. Preload zůstává jen na straně 1
// (stejná volba jako TemaPage), strana 2+ o pásmo s ničím nesoupeří.
const prvni = page === 1 ? articles[0] : undefined;
const prvniVideoId = youtubeId(prvni?.data.video);
const prvniNahled = nahledKarty(prvni?.data.image);
const kartaPreload = prvni
  ? preloadHeroObrazku(prvniVideoId && !prvniNahled.hasLocalThumb
      ? { src: `https://i.ytimg.com/vi/${prvniVideoId}/maxresdefault.jpg` }
      : { src: prvniNahled.localThumb, webp: prvniNahled.hasWebp ? prvniNahled.thumbWebp : undefined, webpSrcset: prvniNahled.thumbWebpSrcset ?? undefined, sizes: KARTA_SIZES })
  : null;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page === 1 ? 'Všechny články' : `Všechny články – strana ${page}`,
  description: 'Kompletní archiv novinek a analýz REALTECH CZ.',
  url: new URL(pagePath(page), Astro.site).href,
  inLanguage: 'cs',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: start + index + 1,
      url: new URL(`/clanky/${article.id}/`, Astro.site).href,
      name: article.data.title,
    })),
  },
};

// Hub /temata/ už breadcrumb má (Novinky → Témata). Archiv ho živě
// 2. 9. 2026 neměl — CollectionPage bez cesty z homepage.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Novinky', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Články', item: new URL('/clanky/', Astro.site).href },
  ],
};

const title = page === 1
  ? 'Všechny články — REALTECH CZ'
  : `Všechny články – strana ${page} — REALTECH CZ`;
const vypisOg = ogObrazekClanku(articles[0]);
---
<Base title={title} description="Všechny články a analýzy REALTECH CZ — AI, drony, Starlink, mobily a hardware bez marketingových řečí." image={vypisOg.image} imageAlt={vypisOg.imageAlt}>
  {kartaPreload && (
    <link
      rel="preload"
      as="image"
      href={kartaPreload.href}
      imagesrcset={kartaPreload.imagesrcset}
      imagesizes={kartaPreload.imagesizes}
      type={kartaPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} slot="head" is:inline />
  {page > 1 && <link rel="prev" href={new URL(pagePath(page - 1), Astro.site)} slot="head" />}
  {page < totalPages && <link rel="next" href={new URL(pagePath(page + 1), Astro.site)} slot="head" />}
  <section class="articles hub" data-archive data-total-pages={totalPages}>
    <div class="wrap">
      <div class="section-head">
        <h1>Všechny články</h1>
      </div>
      {page === 1 && (
        <div class="filter-bar">
          <div class="cat-filter" role="group" aria-label="Filtr podle kategorie">
            <button class="chip active" data-cat="" aria-pressed="true">Vše</button>
            {categories.map((category) => <button class="chip" data-cat={category} aria-pressed="false">{category}</button>)}
          </div>
          <input type="search" class="search-input" id="art-search" placeholder="Hledat článek…" aria-label="Hledat v článcích" />
        </div>
      )}
      <div class="grid" id="articles-grid" aria-busy="false">
        {articles.map((article, index) => (
          <ArticleCard
            article={article}
            titleTag="h2"
            priority={index === 0}
          />
        ))}
      </div>
      {/* Kolo 18: role=status jako u .filter-loading — bez něj čtečka po
          filtru bez shody slyšela jen mizející karty, ne „Nic nenalezeno“. */}
      <p class="filter-empty" role="status" hidden>Nic nenalezeno. Zkus jinou kategorii nebo jiné hledání.</p>
      {/* Kolo 33: prázdný filtr (kategorie + dotaz bez shody) končil jen
          větou — čtenář musel sám najít čip Vše a smazat pole. Tlačítko
          vrátí Vše + prázdné hledání, tedy karty, stránkování i čistou URL. */}
      <button type="button" class="btn-ghost filter-reset" hidden>Zrušit filtr</button>
      <p class="filter-loading" role="status" hidden>Načítám index článků…</p>
      {/* Kolo 29: se shodou čtečka slyšela jen ticho — hlásilo se jen
          „Nic nenalezeno“ a načítání. Počet nalezených jde jen pro čtečku
          (.sr-only), stejně jako „3 výsledky“ v ⌘K hledání (kolo 28). */}
      <p class="filter-count sr-only" role="status" data-filter-count></p>
      <nav class="archive-pagination" aria-label="Stránkování článků">
        {page > 1 && <a class="btn-ghost" href={pagePath(page - 1)} rel="prev">← Novější</a>}
        <span>Strana {page} z {totalPages}</span>
        {page < totalPages && <a class="btn-ghost" href={pagePath(page + 1)} rel="next">Starší →</a>}
      </nav>
    </div>
  </section>

  {page === 1 && (
    <script>
      const chips = [...document.querySelectorAll('.cat-filter .chip')];
      const grid = document.getElementById('articles-grid');
      const empty = document.querySelector('.filter-empty');
      const loading = document.querySelector('.filter-loading');
      const count = document.querySelector('[data-filter-count]');
      const pagination = document.querySelector('.archive-pagination');
      const reset = document.querySelector('.filter-reset');
      const search = document.getElementById('art-search') as HTMLInputElement | null;
      const LOADING_TEXT = 'Načítám index článků…';
      const DEBOUNCE_MS = 300;
      // Tvar položky drží search-index.json.js: i = náhled karty (jako <img src>
      // SSR karty), z = 1 u krátké zprávy, v = délka videa. i/z/v jsou volitelné.
      type PolozkaIndexu = { s: string; t: string; d: string; k: string; b: string; p: string; i?: string; z?: 1; v?: string };
      let index: PolozkaIndexu[] | null = null;
      let loadingIndex: Promise<typeof index> | null = null;
      let debounceTimer = 0;
      let debounceGen = 0;

      const cards = () => [...document.querySelectorAll('#articles-grid .card')];

      const norm = (s: string) =>
        s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      // Česká shoda: 1 článek, 2–4 články, 5+ článků.
      const textPoctuClanku = (pocet: number) => {
        if (pocet === 1) return '1 článek';
        if (pocet >= 2 && pocet <= 4) return `${pocet} články`;
        return `${pocet} článků`;
      };

      // Stejný text musí přijít až po vymazání — jinak čtečka opakovaný
      // „12 článků“ (jiná kategorie, stejný počet) nepřečte (žádná změna DOM).
      const ohlasPocet = (pocet: number) => {
        if (!count) return;
        count.textContent = '';
        if (pocet > 0) window.setTimeout(() => { count.textContent = textPoctuClanku(pocet); }, 50);
      };

      const slugKarty = (card: Element) =>
        card.getAttribute('data-slug')
        ?? card.querySelector('a[href^="/clanky/"]')?.getAttribute('href')?.match(/\/clanky\/([^/]+)/)?.[1]
        ?? '';

      // Třída .th-* jako v ArticleCard (barva štítku + poměr stran náhledu).
      const slugKategorie = (s: string) =>
        s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-');

      // Kolo 35: karta z indexu měla jen .card-body — bez náhledu byla nižší
      // než SSR karty (CLS při každém filtru) a mřížka nejednotná (živě
      // 10. 9. 2026). Teď nese TÝŽ .card-thumb jako ArticleCard: <picture>
      // s náhledem z indexu (lazy — vzniká až po interakci, LCP to není),
      // alt = titulek (#310) a štítky .lt (kategorie, Zpráva, délka videa).
      // Bez `i` zůstane aspoň barevný .th-* blok se štítkem — výška sedí.
      const nahledZIndexu = (it: PolozkaIndexu) => {
        const thumb = document.createElement('div');
        thumb.className = `card-thumb th-${slugKategorie(it.k)}`;
        if (it.i) {
          const picture = document.createElement('picture');
          const img = document.createElement('img');
          img.setAttribute('src', it.i);
          img.setAttribute('alt', it.t);
          // -640 derivát = 640×360, jinak plný 1280×720 (jako nahledKarty na serveru).
          const maly = /-640\.(?:webp|jpg)$/.test(it.i);
          img.setAttribute('width', maly ? '640' : '1280');
          img.setAttribute('height', maly ? '360' : '720');
          img.setAttribute('loading', 'lazy');
          img.setAttribute('decoding', 'async');
          picture.append(img);
          thumb.append(picture);
        }
        const lt = document.createElement('div');
        lt.className = 'lt';
        const kategorie = document.createElement('span');
        kategorie.className = 'k';
        kategorie.textContent = it.k;
        lt.append(kategorie);
        if (it.z) {
          const zprava = document.createElement('span');
          zprava.className = 'z';
          zprava.textContent = 'Zpráva';
          lt.append(zprava);
        }
        if (it.v) {
          const delka = document.createElement('span');
          delka.className = 't';
          delka.textContent = it.v;
          lt.append(delka);
        }
        thumb.append(lt);
        return thumb;
      };

      const kartaZIndexu = (it: PolozkaIndexu) => {
        const article = document.createElement('article');
        article.className = 'card';
        article.setAttribute('data-category', it.k);
        article.setAttribute('data-slug', it.s);
        article.setAttribute('data-from-index', '');
        const body = document.createElement('div');
        body.className = 'card-body';
        const nadpis = document.createElement('h2');
        const odkaz = document.createElement('a');
        odkaz.setAttribute('href', `/clanky/${it.s}/`);
        odkaz.textContent = it.t;
        nadpis.append(odkaz);
        const perex = document.createElement('p');
        perex.textContent = it.d;
        const meta = document.createElement('div');
        meta.className = 'card-meta';
        const cas = document.createElement('time');
        cas.setAttribute('datetime', it.p);
        cas.textContent = it.p.split('-').reverse().join('. ');
        meta.append(cas);
        body.append(nadpis, perex, meta);
        article.append(nahledZIndexu(it), body);
        return article;
      };

      const loadIndex = () => {
        if (index) return Promise.resolve(index);
        if (loadingIndex) return loadingIndex;
        grid?.setAttribute('aria-busy', 'true');
        if (loading) {
          loading.textContent = LOADING_TEXT;
          loading.removeAttribute('hidden');
        }
        loadingIndex = (async () => {
          const response = await fetch('/search-index.json');
          if (!response.ok) throw new Error('Archiv: search-index.json se nenačetl.');
          index = await response.json();
          return index;
        })().catch((err) => {
          loadingIndex = null;
          throw err;
        }).finally(() => {
          grid?.setAttribute('aria-busy', 'false');
          loading?.setAttribute('hidden', '');
        });
        return loadingIndex;
      };

      const apply = async () => {
        const category = document.querySelector('.chip.active')?.getAttribute('data-cat') ?? '';
        const query = (search?.value ?? '').trim();
        const nq = norm(query);
        cards().forEach((card) => {
          if (card.hasAttribute('data-from-index')) card.remove();
        });
        if (!category && !nq) {
          cards().forEach((card) => card.toggleAttribute('hidden', false));
          empty?.toggleAttribute('hidden', true);
          reset?.toggleAttribute('hidden', true);
          pagination?.toggleAttribute('hidden', false);
          ohlasPocet(0);
          history.replaceState(null, '', location.pathname);
          return;
        }

        try {
          await loadIndex();
        } catch {
          if (loading) {
            loading.textContent = 'Index článků se nepodařilo načíst. Zkus hledání znovu.';
            loading.removeAttribute('hidden');
          }
          return;
        }

        const slugs = new Set(
          (index ?? [])
            .filter((it) => {
              if (category && it.k !== category) return false;
              if (!nq) return true;
              return norm(`${it.t} ${it.d} ${it.k} ${it.b}`).includes(nq);
            })
            .map((it) => it.s),
        );
        const naStrane = new Set<string>();
        let shown = 0;
        cards().forEach((card) => {
          const slug = slugKarty(card);
          const show = slugs.has(slug);
          card.toggleAttribute('hidden', !show);
          if (show) {
            shown++;
            if (slug) naStrane.add(slug);
          }
        });
        for (const it of index ?? []) {
          if (!slugs.has(it.s) || naStrane.has(it.s)) continue;
          grid?.append(kartaZIndexu(it));
          shown++;
        }
        empty?.toggleAttribute('hidden', shown > 0);
        reset?.toggleAttribute('hidden', shown > 0);
        pagination?.toggleAttribute('hidden', true);
        ohlasPocet(shown);

        const params = new URLSearchParams();
        if (category) params.set('kat', category);
        if (query) params.set('q', query);
        const queryString = params.toString();
        history.replaceState(null, '', queryString ? `?${queryString}` : location.pathname);
      };

      const activate = (chip: Element) => {
        chips.forEach((item) => {
          item.classList.remove('active');
          item.setAttribute('aria-pressed', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-pressed', 'true');
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activate(chip);
          debounceGen++;
          if (debounceTimer) window.clearTimeout(debounceTimer);
          void apply();
        });
      });
      // Kolo 33: Zrušit filtr = čip Vše + prázdné pole + apply() (ten sám
      // odkryje karty, vrátí stránkování a zahodí ?kat/?q z URL). Tlačítko
      // se přitom schová, tak fokus jde na čip Vše — jinak by spadl na body.
      reset?.addEventListener('click', () => {
        const vse = chips.find((chip) => chip.getAttribute('data-cat') === '');
        if (vse) activate(vse);
        if (search) search.value = '';
        debounceGen++;
        if (debounceTimer) window.clearTimeout(debounceTimer);
        void apply();
        (vse as HTMLElement | undefined)?.focus?.();
      });
      search?.addEventListener('input', () => {
        const gen = ++debounceGen;
        if (debounceTimer) window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          if (gen === debounceGen) void apply();
        }, DEBOUNCE_MS);
      });

      const params = new URLSearchParams(location.search);
      const initialCategory = params.get('kat');
      const initialQuery = params.get('q');
      if (initialQuery && search) search.value = initialQuery;
      if (initialCategory) {
        const target = chips.find((chip) => chip.getAttribute('data-cat') === initialCategory);
        if (target) activate(target);
      }
      if (initialCategory || initialQuery) void apply();
    </script>
  )}
</Base>
