---
// Globální vyhledávání (⌘K / Ctrl+K) — modal s fulltextem přes všechny články.
// Index se stahuje až při prvním otevření, ovládání klávesnicí (šipky, Enter, Esc).
---
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="Vyhledávání v článcích">
    <div class="search-head">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="search-icon"><path d="M10 3a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 10 3zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z"/></svg>
      <input type="search" id="search-q" placeholder="Hledat v článcích…" autocomplete="off" aria-label="Hledaný výraz" />
      <kbd class="search-esc">ESC</kbd>
    </div>
    <div class="search-results" id="search-results" role="listbox" aria-label="Výsledky"></div>
    <div class="search-foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> pohyb</span>
      <span><kbd>↵</kbd> otevřít</span>
      <span>REALTECH<span class="sf-red">.CZ</span></span>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-q') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  let index: any[] | null = null;
  let active = 0;

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  // Titulek i kategorie jdou do innerHTML. Bez escapování by `<` v obsahu
  // rozbilo výpis a mohlo vložit cizí značku (Z10027 / WEB-SEARCH-003).
  const escapeHtml = (s: string) =>
    String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  async function loadIndex() {
    if (index) return index;
    try {
      const res = await fetch('/search-index.json');
      index = await res.json();
    } catch { index = []; }
    return index;
  }

  function render(items: any[], q: string) {
    if (!results) return;
    if (!q) {
      results.innerHTML = `<p class="search-hint">Napiš, co hledáš — třeba <em>starlink</em>, <em>DJI</em> nebo <em>Claude</em>.</p>`;
      return;
    }
    if (!items.length) {
      results.innerHTML = `<p class="search-hint">Nic nenalezeno. Zkus jiné slovo.</p>`;
      return;
    }
    results.innerHTML = items
      .map((it, i) => `
        <a class="search-item${i === active ? ' active' : ''}" href="/clanky/${it.s}/" role="option" data-i="${i}">
          <span class="si-cat">${escapeHtml(it.k)}</span>
          <span class="si-title">${escapeHtml(it.t)}</span>
          <span class="si-date mono">${it.p.split('-').reverse().join('. ')}</span>
        </a>`)
      .join('');
  }

  function search(q: string) {
    if (!index) return [];
    const nq = norm(q.trim());
    if (!nq) return [];
    const terms = nq.split(/\s+/);
    return index
      .map((it) => {
        const hayTitle = norm(it.t);
        const hayRest = norm(`${it.d} ${it.k} ${it.b}`);
        let score = 0;
        for (const t of terms) {
          if (hayTitle.includes(t)) score += 10;
          else if (hayRest.includes(t)) score += 3;
          else return null;
        }
        return { it, score };
      })
      .filter(Boolean)
      .sort((a: any, b: any) => b.score - a.score)
      .slice(0, 8)
      .map((r: any) => r.it);
  }

  let current: any[] = [];

  async function open() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    active = 0;
    render([], '');
    input.focus();
    await loadIndex();
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay?.hidden ? open() : close();
      return;
    }
    if (overlay?.hidden) return;
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!current.length) return;
      active = e.key === 'ArrowDown'
        ? (active + 1) % current.length
        : (active - 1 + current.length) % current.length;
      render(current, input?.value ?? '');
      results?.querySelector('.search-item.active')?.scrollIntoView({ block: 'nearest' });
      return;
    }
    if (e.key === 'Enter' && current[active]) {
      location.href = `/clanky/${current[active].s}/`;
    }
  });

  input?.addEventListener('input', () => {
    active = 0;
    current = search(input.value);
    render(current, input.value);
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  document.querySelectorAll('[data-search-open]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); open(); })
  );
</script>
