---
// Globální vyhledávání (⌘K / Ctrl+K) — modal s fulltextem přes všechny články.
// Index se stahuje až při prvním otevření, ovládání klávesnicí (šipky, Enter, Esc).
---
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-box" role="dialog" aria-modal="true" aria-label="Vyhledávání v článcích">
    {/*
      Kolo 37: hlava dialogu je GET formulář na archiv — stejný cíl a
      parametr jako .search-form na /clanky/ (kolo 36). Pole tak není
      jen klientský combobox: Enter bez aktivního výsledku (nic
      nenalezeno, index se nenačetl) pošle dotaz na /clanky/?q=…, kde
      filtr běží nad seznamem v HTML a URL je sdílitelná. Enter s
      výsledkem dál otvírá aktivní článek (handler keydown níž), submit
      to jen nezdvojí. Tlačítko ESC je type=button — implicitní odeslání
      spouští jen Enter v jediném textovém poli.
    */}
    <form class="search-head" action="/clanky/" method="get">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="search-icon"><path d="M10 3a7 7 0 1 0 4.2 12.6l4.1 4.1 1.4-1.4-4.1-4.1A7 7 0 0 0 10 3zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z"/></svg>
      {/*
        Combobox pattern (WAI-ARIA APG): výsledky jsou listbox s option,
        ale input o nich dřív nevěděl — čtečka tak nehlásila rozbalení
        ani aktivní položku při šipkách. aria-activedescendant přepíná
        skript v render().
      */}
      <input
        type="search"
        id="search-q"
        name="q"
        placeholder="Hledat v článcích…"
        autocomplete="off"
        maxlength="200"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-haspopup="listbox"
        aria-label="Hledaný výraz"
      />
      {/*
        Kolo 19: „ESC“ byl jen <kbd> — dialog neměl žádný ovládací prvek
        k zavření (WAI-ARIA dialog pattern ho chce). Na telefonu, kde Esc
        neexistuje, se dal modal opustit jen klepnutím do 20px lemu kolem
        okna (živě 4. 9. 2026 na 390px). Tlačítko kreslí na desktopu dál
        klávesu ESC, pod 900px křížek (stejný práh jako skrytí .st-kbd
        v hlavičce — bez fyzické klávesnice nemá klávesa co říct).
      */}
      <button type="button" class="search-esc" data-search-close aria-label="Zavřít hledání">
        <kbd class="search-esc-kbd" aria-hidden="true">ESC</kbd>
        <svg class="search-esc-x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 5 5 6.4l5.6 5.6L5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6z"/></svg>
      </button>
    </form>
    {/*
      Kolo 28: nápověda a „Nic nenalezeno“ stály UVNITŘ listboxu jako <p>
      (axe aria-required-children, critical — listbox smí mít jen option)
      a čtečka o nich nevěděla: stav se jen přepsal v DOM. Teď je to
      sourozenec s role=status: nápověda a prázdný výsledek jsou vidět,
      počet nalezených („3 výsledky“) se jen ohlásí (.sr-only). Listbox
      s option se ukáže, až když je co vybírat — do té doby je hidden
      (APG combobox: zavřený popup není v DOM vidět).
    */}
    <p class="search-hint" id="search-hint" role="status"></p>
    <div class="search-results" id="search-results" role="listbox" aria-label="Výsledky" tabindex="-1" hidden></div>
    <a class="search-all-results" id="search-all-results" href="/clanky/" hidden>Hledat v archivu</a>
    <div class="search-foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> pohyb</span>
      <span><kbd>↵</kbd> otevřít</span>
      <span>REALTECH<span class="sf-red">.CZ</span></span>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-q') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const hint = document.getElementById('search-hint');
  const allResults = document.getElementById('search-all-results') as HTMLAnchorElement | null;
  let totalResults = 0;
  let index: any[] | null = null;
  // Kolo 28: jeden fetch indexu najednou (open() i první stisk klávesy ho
  // chtějí zároveň) a flag, že poslední pokus selhal — ať render umí
  // rozlišit „ještě se načítá“ od „nefunguje“.
  let nacitaniIndexu: Promise<any[]> | null = null;
  let indexSelhal = false;
  let active = 0;
  let returnFocus: HTMLElement | null = null;

  const focusableSelector =
    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), ' +
    'textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  // Titulek i kategorie jdou do innerHTML. Bez escapování by `<` v obsahu
  // rozbilo výpis a mohlo vložit cizí značku (Z10027 / WEB-SEARCH-003).
  const escapeHtml = (s: string) =>
    String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  async function loadIndex() {
    if (index) return index;
    if (nacitaniIndexu) return nacitaniIndexu;
    nacitaniIndexu = (async () => {
      try {
        const res = await fetch('/search-index.json');
        if (!res.ok) {
          indexSelhal = true;
          return [];
        }
        const data = await res.json();
        // Chybnou odpověď neukládat: jinak další dotaz padá až do reloadu.
        if (!Array.isArray(data) || !data.every((it) => it &&
          ['s', 't', 'd', 'k', 'b', 'p'].every((key) => typeof it[key] === 'string') &&
          /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(it.s))) {
          indexSelhal = true;
          return [];
        }
        index = data;
        indexSelhal = false;
        return index as any[];
      } catch {
        indexSelhal = true;
        return [];
      } finally {
        nacitaniIndexu = null;
      }
    })();
    return nacitaniIndexu;
  }

  // Input je combobox — když listbox ukazuje option, musí mít
  // aria-expanded=true a aria-activedescendant na aktivní položce,
  // jinak čtečka pohyb šipkami vůbec neohlásí.
  function syncCombobox(expanded: boolean) {
    input?.setAttribute('aria-expanded', String(expanded));
    if (expanded) input?.setAttribute('aria-activedescendant', `search-item-${active}`);
    else input?.removeAttribute('aria-activedescendant');
  }

  // Česká shoda počtu všech shod, nikoli jen osmi náhledů.
  function textPoctuVysledku(pocet: number) {
    if (pocet === 1) return '1 výsledek';
    if (pocet >= 2 && pocet <= 4) return `${pocet} výsledky`;
    return `${pocet} výsledků`;
  }

  // Stavový řádek pod polem: viditelná nápověda / prázdný výsledek, nebo
  // jen ohlášení počtu pro čtečku (jenProCtecky → .sr-only), když listbox
  // ukazuje výsledky. role=status ohlásí každou změnu textu sám.
  function nastavStav(html: string, jenProCtecky: boolean) {
    if (!hint) return;
    hint.innerHTML = html;
    hint.classList.toggle('sr-only', jenProCtecky);
  }

  function render(items: any[], q: string) {
    if (!results) return;
    q = q.trim();
    if (allResults) {
      allResults.hidden = !q;
      // Kolo 53: výsledek přes kmeny posílá do archivu kmenový dotaz
      // („raketě“ → „raket“) — archiv hledá podřetězcem, takže najde totéž,
      // co modal ukázal (review: jinak „Všechny výsledky (N)“ → 0 v archivu).
      const qArchiv = kmenovyDotaz && kmenovyDotaz.zdroj === q ? kmenovyDotaz.kmeny : q;
      allResults.href = q ? `/clanky/?q=${encodeURIComponent(qArchiv)}` : '/clanky/';
      allResults.textContent = items.length ? `Všechny výsledky (${totalResults || items.length})` : 'Hledat v archivu';
    }
    if (!q || !items.length) {
      results.innerHTML = '';
      results.hidden = true;
      syncCombobox(false);
      if (!q) {
        nastavStav(`Napiš, co hledáš — třeba <em>Astra</em>, <em>Anthropic</em> nebo <em>Starlink</em>.`, false);
      } else if (index) {
        nastavStav('Nic nenalezeno. Zkus jiné slovo.', false);
      } else if (indexSelhal) {
        nastavStav('Index článků se nepodařilo načíst. Zkus hledání znovu.', false);
      } else {
        // Kolo 28: kdo začal psát dřív, než dorazil index, viděl
        // „Nic nenalezeno“ — a to až do dalšího stisku klávesy, protože
        // po načtení indexu nikdo výsledky nepřekreslil (viz obnovVysledky).
        nastavStav('Načítám články…', false);
      }
      return;
    }
    results.innerHTML = items
      .map((it, i) => `
        <a class="search-item${i === active ? ' active' : ''}" href="/clanky/${escapeHtml(it.s)}/" role="option" id="search-item-${i}" aria-selected="${i === active}" tabindex="-1" data-i="${i}">
          <span class="si-cat">${escapeHtml(it.k)}</span>
          <span class="si-title">${escapeHtml(it.t)}</span>
          <span class="si-date mono">${escapeHtml(it.p.split('-').reverse().join('. '))}</span>
        </a>`)
      .join('');
    results.hidden = false;
    const total = totalResults || items.length;
    nastavStav(total > items.length
      ? `${textPoctuVysledku(total)} · Zobrazeno prvních ${items.length}.`
      : textPoctuVysledku(total), total <= items.length);
    syncCombobox(true);
  }

  // Kolo 53: čeština skloňuje — „raketě“ nenašlo „raketa“, „dronů“ ne „drony“.
  // Když přesné termíny nenajdou nic, zkusí se znovu s kmeny (u slov od 5
  // znaků se uřízne 1–2 znaky koncovky). Jen záloha při nule, pořadí
  // přesných výsledků se nemění.
  function kmen(t: string) {
    // Kolo 55: slovo s číslicí je název modelu/verze („gpt-5“, „m8“) —
    // zkrácené „gpt-“ by našlo i GPT-6. Neskloňuje se, neřeže se.
    if (t.length < 5 || /\d/.test(t)) return t;
    return t.slice(0, t.length >= 7 ? -2 : -1);
  }

  // Poslední dotaz, který našel výsledky jen přes kmeny (pro odkaz do archivu).
  let kmenovyDotaz: { zdroj: string; kmeny: string } | null = null;

  // Kolo 55: kmen už není jen záloha při nule. Živě 26. 9. 2026 našlo
  // „raketa“ 3 články a „raketě“ 6, „dronů“ 1 (jediný článek s tvarem
  // „dronů“) místo rubriky Drony — přesná shoda existovala, takže se kmeny
  // nezkoušely. Kmenový průchod je vždy nadmnožina přesného (kmen je
  // předpona slova); použije se, když najde víc, a přesné shody v něm
  // dostávají vyšší skóre, takže zůstávají nahoře.
  function search(q: string) {
    kmenovyDotaz = null;
    const presne = hledej(q, false);
    const presnyPocet = totalResults;
    const nq = norm(q.trim());
    const kmeny = nq.split(/\s+/).map(kmen).join(' ');
    // Žádné slovo se nezkrátilo → druhý průchod by byl totožný.
    if (!nq || kmeny === nq) return presne;
    const sKmeny = hledej(q, true);
    if (totalResults > presnyPocet) {
      kmenovyDotaz = { zdroj: q.trim(), kmeny };
      return sKmeny;
    }
    totalResults = presnyPocet;
    return presne;
  }

  function hledej(q: string, sKmeny: boolean) {
    totalResults = 0;
    if (!index) return [];
    const nq = norm(q.trim());
    if (!nq) return [];
    const slova = nq.split(/\s+/);
    const matches = index
      .map((it) => {
        const hayTitle = norm(it.t);
        const hayRest = norm(`${it.d} ${it.k} ${it.b}`);
        let score = 0;
        for (const slovo of slova) {
          const t = sKmeny ? kmen(slovo) : slovo;
          // Kolo 55: přesný tvar slova má přednost před shodou jen kmenem.
          if (sKmeny && hayTitle.includes(slovo)) score += 12;
          else if (hayTitle.includes(t)) score += 10;
          else if (sKmeny && hayRest.includes(slovo)) score += 4;
          else if (hayRest.includes(t)) score += 3;
          else return null;
        }
        return { it, score };
      })
      .filter(Boolean)
      .sort((a: any, b: any) => {
        const byScore = b.score - a.score;
        if (byScore !== 0) return byScore;
        // Stejné skóre → novější `p` (YYYY-MM-DD) první. Chybějící datum
        // nesmí shodit řazení — bere se jako nejstarší.
        const dateA = typeof a.it?.p === 'string' ? a.it.p : '';
        const dateB = typeof b.it?.p === 'string' ? b.it.p : '';
        return dateB.localeCompare(dateA);
      })
      .map((r: any) => r.it);
    totalResults = matches.length;
    return matches.slice(0, 8);
  }

  let current: any[] = [];

  // Přehledá, co je právě v poli, a překreslí — po doručení indexu.
  // Zavřený modal nechává být (index dorazil až po Escape).
  function obnovVysledky() {
    if (!overlay || overlay.hidden || !input) return;
    active = 0;
    current = search(input.value);
    render(current, input.value);
  }

  async function open(invoker?: HTMLElement | null) {
    if (!overlay || !input) return;
    const focused = invoker ?? document.activeElement;
    returnFocus = focused && typeof (focused as HTMLElement).focus === 'function'
      ? focused as HTMLElement
      : null;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    current = [];
    active = 0;
    render([], '');
    input.focus();
    await loadIndex();
    obnovVysledky();
  }

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
    const target = returnFocus;
    returnFocus = null;
    target?.focus();
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      overlay?.hidden ? open(document.activeElement as HTMLElement | null) : close();
      return;
    }
    if (!overlay || overlay.hidden) return;
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'Tab') {
      // a[href] zahrne i option s tabindex=-1, které nejsou v pořadí Tab.
      const focusable = Array.from(overlay.querySelectorAll<HTMLElement>(focusableSelector))
        .filter((el) => el.tabIndex >= 0 && !el.hidden);
      if (!focusable.length) {
        e.preventDefault();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const focused = document.activeElement;
      if (e.shiftKey && (focused === first || !overlay.contains(focused))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (focused === last || !overlay.contains(focused))) {
        e.preventDefault();
        first.focus();
      }
      return;
    }
    if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && e.target === input) {
      e.preventDefault();
      if (!current.length) return;
      active = e.key === 'ArrowDown'
        ? (active + 1) % current.length
        : (active - 1 + current.length) % current.length;
      render(current, input?.value ?? '');
      results?.querySelector('.search-item.active')?.scrollIntoView({ block: 'nearest' });
      return;
    }
    // Kolo 32: Enter otvírá aktivní výsledek jen z pole. Handler sedí na
    // document, takže Enter na tlačítku „Zavřít hledání“ (Tab z pole) dřív
    // s výsledky v listboxu poslal čtenáře na první článek místo zavření —
    // navigace předběhla click, který Enter na <button> vyvolá.
    if (e.key === 'Enter' && e.target === input && current[active]) {
      location.href = `/clanky/${current[active].s}/`;
    }
  });

  // Kolo 37: hlava dialogu je GET formulář na /clanky/?q=. Enter s aktivním
  // výsledkem už navigoval handler keydown výš — tady se jen zastaví
  // implicitní odeslání, aby ho nepředběhl archiv. Bez výsledku (nic
  // nenalezeno, index nedorazil) jde dotaz do archivu, kde filtr běží nad
  // seznamem v HTML; prázdné pole nikam neposílá.
  const formular = input?.form ?? null;
  formular?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (current[active]) return;
    const dotaz = input?.value.trim() ?? '';
    if (dotaz) location.href = `/clanky/?q=${encodeURIComponent(dotaz)}`;
  });

  input?.addEventListener('input', () => {
    active = 0;
    current = search(input.value);
    render(current, input.value);
    // Index ještě není (pomalá síť, nebo minule selhal): stáhnout a po
    // doručení dotaz zopakovat — druhý pokus po chybě je tady, ne až po
    // zavření a otevření modalu.
    if (!index) void loadIndex().then(obnovVysledky);
  });

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  document.querySelectorAll('[data-search-open]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); open(e.currentTarget as HTMLElement); })
  );
  document.querySelectorAll('[data-search-close]').forEach((el) =>
    el.addEventListener('click', () => close())
  );
</script>
