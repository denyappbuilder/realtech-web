---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/reading-time.js';
import { youtubeId } from '../lib/youtube.js';
import { nahledKarty } from '../lib/karta-nahled.js';
import { formatCalendarDateCs } from '../lib/calendarDate.js';

interface Props {
  article: CollectionEntry<'clanky'>;
  /** První karta nad okrajem na výpisu — LCP. Úvodka to nesmí dostat, tam už ho má hero. */
  priority?: boolean;
}
const { article, priority = false } = Astro.props;
const { title, description, category, date, video, videoLength, zprava, image } = article.data;
const readMinutes = readingTime(article.body);

const slugify = (s: string) =>
  s.toLowerCase()
   .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
   .replace(/\s+/g, '-');

const thumbClass = `th-${slugify(category)}`;
const dateStr = formatCalendarDateCs(date);
const videoId = youtubeId(video);

// Karta renderuje ~400 px — 640px a WebP jen u JPG (Z1071).
// Lokální cover má přednost i u videa: 640px WebP má ~25 KB, YouTube
// maxresdefault ~170 KB (živě 26. 8. 2026 karta „Starlink v Česku 2026"
// stahovala YT JPEG, i když lokální WebP v repu byl). YouTube náhled je
// jen fallback, když soubor v repu chybí — a to maxresdefault (1280×720,
// 16:9), stejně jako hero článku (#299). hqdefault je 480×360 s černými
// pruhy (4:3) a karta s aspect-ratio 16/9 by z něj ořezávala.
// Když se použije YouTube, WebP z lokálního coveru se vynuluje — <source>
// by v <picture> přebil YouTube náhled (Z10093).
const { localThumb, thumbW: localW, thumbH: localH, thumbWebp: localWebp, hasWebp: localHasWebp, hasLocalThumb, lcpSrc: localLcpSrc } = nahledKarty(image);
const useYtThumb = Boolean(videoId) && !hasLocalThumb;
const thumbUrl = useYtThumb ? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg` : localThumb;
const [thumbW, thumbH] = useYtThumb ? [1280, 720] : [localW, localH];
const thumbWebp = useYtThumb ? null : localWebp;
const hasWebp = useYtThumb ? false : localHasWebp;
const lcpSrc = useYtThumb ? thumbUrl : localLcpSrc;
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---
<article class="card" data-category={category}>
  {/*
    Náhled karty nese titulek článku jako alt — stejné pravidlo jako hero
    článku (#310). Živě (2026-08-24) šly všechny karty na /clanky/ ven
    s alt="", včetně první eager (LCP). Frontmatter vlastní alt obrázku
    nemá, alt je data.title. Odkaz kolem náhledu zůstává aria-hidden +
    tabindex="-1" (duplicitní odkaz — jméno karty dává <h3>), alt ale
    slouží i při výpadku obrázku a pro vyhledávače obrázků.
  */}
  <a href={`/clanky/${article.id}/`} class={`card-thumb ${thumbClass}`} aria-hidden="true" tabindex="-1">
    {thumbUrl && (
      <picture>
        {hasWebp && <source srcset={thumbWebp} type="image/webp" />}
        <img src={lcpSrc} alt={title} width={thumbW} height={thumbH} loading={loading} decoding="async" fetchpriority={fetchpriority} />
      </picture>
    )}
    <div class="lt">
      <span class="k">{category}</span>
      {zprava && <span class="z">Zpráva</span>}
      {videoLength && <span class="t">{videoLength}</span>}
    </div>
  </a>
  <div class="card-body">
    <h3><a href={`/clanky/${article.id}/`}>{title}</a></h3>
    <p>{description}</p>
    <div class="card-meta">
      <time datetime={date.toISOString().slice(0, 10)}>{dateStr}</time>
      <span>ČTENÍ {readMinutes} MIN</span>
    </div>
  </div>
</article>
