---
import { getCollection } from 'astro:content';
import { KARTA_SIZES, nahledKarty } from '../lib/karta-nahled.js';
import { youtubeId } from '../lib/youtube.js';
import { preloadHeroObrazku } from '../lib/hero-preload.js';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';

const YT = 'https://www.youtube.com/@realtech-cz';
const YT_SUB = 'https://www.youtube.com/@realtech-cz?sub_confirmation=1';

const latest = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// LCP na /vitej/ je náhled první karty (dostává priority, stránka nemá hero
// obrázek), ale živě šla stránka ven bez preloadu v <head> — prohlížeč
// našel obrázek až při parsování <body>. Stejný výpočet jako na /clanky/
// (ArticleArchivePage): míří na tentýž soubor, který si <picture> karty
// vybere — lokální WebP, jinak JPG/ytimg fallback.
const prvni = latest[0];
const prvniVideoId = youtubeId(prvni?.data.video);
const prvniNahled = nahledKarty(prvni?.data.image);
const kartaPreload = prvni
  ? preloadHeroObrazku(prvniVideoId && !prvniNahled.hasLocalThumb
      ? { src: `https://i.ytimg.com/vi/${prvniVideoId}/maxresdefault.jpg` }
      : { src: prvniNahled.localThumb, webp: prvniNahled.hasWebp ? prvniNahled.thumbWebp : undefined, webpSrcset: prvniNahled.thumbWebpSrcset ?? undefined, sizes: KARTA_SIZES })
  : null;
---
<Base
  title="Vítej v RealTechu — REALTECH CZ"
  description="Odběr potvrzen. Vítej v RealTech newsletteru."
  robots="noindex, max-image-preview:large"
>
  {kartaPreload && (
    <link
      rel="preload"
      as="image"
      href={kartaPreload.href}
      imagesrcset={kartaPreload.imagesrcset}
      imagesizes={kartaPreload.imagesizes}
      type={kartaPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <section class="about wrap">
    <div class="lower-third">
      <span class="tag">Newsletter</span>
      <span class="tag tag-zprava">Odběr potvrzen ✓</span>
    </div>
    <h1>Vítej v RealTechu. ⚡</h1>
    <p>
      Tady <strong>Deny a Sam</strong>. Díky za důvěru — od teď ti občas přistane v mailu
      to nejdůležitější z AI a techu. Česky, stručně, bez marketingových řečí.
      Píšeme, jen když je co říct.
    </p>

    <h2>Co od nás čekat</h2>
    <p>
      Novinky a analýzy, které ti reálně něco změní — žádné tiskovky. Upozornění na nová
      videa. A varování, ať tě nic nezaskočí: bany, konce podpory, změny cen.
    </p>

    <h2>Zatím se mrkni</h2>
    <div class="hero-actions">
      <a href={YT_SUB} class="yt-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
        Odebírat na YouTube
      </a>
      <a href="/clanky/" class="btn-ghost">Všechny články →</a>
    </div>

    <div class="related">
      <div class="section-head">
        <h2>Nejnovější reporty</h2>
      </div>
      <div class="grid">
        {/* První karta je LCP — /vitej/ nemá hero obrázek (viz test-karta-lcp). */}
        {latest.map((c, i) => <ArticleCard article={c} priority={i === 0} />)}
      </div>
    </div>
  </section>
</Base>
