---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(all.map((c) => c.data.category))];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Všechny články',
  description: 'Kompletní archiv novinek a analýz REALTECH CZ.',
  url: new URL('/clanky/', Astro.site).href,
  inLanguage: 'cs',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/clanky/${c.id}/`, Astro.site).href,
      name: c.data.title,
    })),
  },
};
---
<Base title="Všechny články — REALTECH CZ" description="Všechny články a analýzy REALTECH CZ — AI, drony, Starlink, mobily a hardware bez marketingových řečí.">
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} slot="head" is:inline />
  <section class="articles" style="padding-top: 56px;">
    <div class="wrap">
      <div class="section-head">
        <h1>Všechny články</h1>
        <a href="/rss.xml">RSS →</a>
      </div>
      <div class="filter-bar">
        <div class="cat-filter" role="group" aria-label="Filtr podle kategorie">
          <button class="chip active" data-cat="" aria-pressed="true">Vše</button>
          {categories.map((cat) => <button class="chip" data-cat={cat} aria-pressed="false">{cat}</button>)}
        </div>
        <input type="search" class="search-input" id="art-search" placeholder="Hledat článek…" aria-label="Hledat v článcích" />
      </div>
      <div class="grid" id="articles-grid">
        {all.map((article) => <ArticleCard article={article} />)}
      </div>
      <p class="filter-empty" hidden>Nic nenalezeno. Zkus jinou kategorii nebo jiné hledání.</p>
      {all.length > 12 && (
        <div class="load-more-wrap">
          <button id="load-more" class="btn-ghost" hidden>Zobrazit starší články ({all.length - 12})</button>
        </div>
      )}
    </div>
  </section>

  <script>
    const chips = [...document.querySelectorAll('.cat-filter .chip')];
    const cards = [...document.querySelectorAll('#articles-grid .card')];
    const empty = document.querySelector('.filter-empty');
    const search = document.getElementById('art-search') as HTMLInputElement | null;

    // Progresivní načítání: bez JS se zobrazí vše; s JS prvních 12 + tlačítko.
    // Jakékoli filtrování/hledání stránkování zruší (hledá se ve všem).
    const loadMore = document.getElementById('load-more');
    let paged = false;
    if (loadMore && cards.length > 12) {
      cards.slice(12).forEach((c) => c.setAttribute('hidden', ''));
      loadMore.hidden = false;
      paged = true;
    }
    const unpage = () => {
      if (!paged) return;
      paged = false;
      if (loadMore) loadMore.hidden = true;
      cards.forEach((c) => c.removeAttribute('hidden'));
    };
    loadMore?.addEventListener('click', unpage);

    const apply = () => {
      unpage();
      const cat = document.querySelector('.chip.active')?.getAttribute('data-cat') ?? '';
      const q = (search?.value ?? '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const okCat = !cat || card.getAttribute('data-category') === cat;
        const okQ = !q || (card.textContent ?? '').toLowerCase().includes(q);
        const show = okCat && okQ;
        card.toggleAttribute('hidden', !show);
        if (show) shown++;
      });
      empty?.toggleAttribute('hidden', shown > 0);
      const params = new URLSearchParams();
      if (cat) params.set('kat', cat);
      if (q) params.set('q', q);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    const activate = (chip: Element) => {
      chips.forEach((c) => { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
      chip.classList.add('active');
      chip.setAttribute('aria-pressed', 'true');
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activate(chip);
        apply();
      });
    });
    search?.addEventListener('input', apply);

    const params = new URLSearchParams(location.search);
    const initCat = params.get('kat');
    const initQ = params.get('q');
    if (initQ && search) search.value = initQ;
    if (initCat) {
      const target = chips.find((c) => c.getAttribute('data-cat') === initCat);
      if (target) activate(target);
    }
    if (initCat || initQ) apply();
  </script>
</Base>
