---
import fs from 'node:fs';
import { seoTitulek } from '../../lib/seo-titulek.js';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { slugify } from '../../lib/slugify.js';
import { readingTime } from '../../lib/reading-time.js';
import { youtubeId } from '../../lib/youtube.js';
import { xPostEmbed } from '../../lib/x-post.js';
import { isoDuration } from '../../lib/iso-duration.js';
import { formatCalendarDateCs } from '../../lib/calendarDate.js';
import { compareArticlesByDateDescThenId } from '../../lib/article-order.js';
import AudioPrehled from '../../components/AudioPrehled.astro';
import { jsonLdText, pripojAudioKClanku, vytvorAudioObject } from '../../lib/audio-prehled.js';
import { heroObrazekClanku } from '../../lib/hero-obrazek.js';
import { preloadHeroObrazku } from '../../lib/hero-preload.js';

export async function getStaticPaths() {
  const clanky = await getCollection('clanky', ({ data }) => !data.draft);
  return clanky.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, seoTitle, description, category, date, video, videoLength, zprava, image, updated, audio, xPosts } = article.data;
const readMinutes = readingTime(article.body);
const dateStr = formatCalendarDateCs(date);
const updatedStr = formatCalendarDateCs(updated);

const videoId = youtubeId(video);
// Oficiální click-to-load embed X. Schéma pustí jen platné status URL —
// parser vrací kanonický twitter.com href pro widgets.js a x.com webHref
// pro lidský fallback odkaz. flatMap místo filter s type-predikátem:
// frontmatter běží v testech jako čistý JS modul (test-clanek-jsonld-loader).
const xEmbedy = (xPosts ?? []).flatMap((url) => xPostEmbed(url) ?? []);
const {
  src: heroSrc,
  lcpSrc: heroLcpSrc,
  srcset: heroSrcset,
  webp: heroWebp,
  webpSrcset: heroWebpSrcset,
  sizes: heroSizes,
} = heroObrazekClanku(image, videoId);
// Cover článku žije přímo ve fasádě X — stejný princip jako YouTube fasáda:
// jedna fotoreálná 16:9 plocha s play ovladačem, žádný druhý tmavý panel
// pod hero obrázkem. Samostatný .article-hero se pak vynechá; preload v
// <head> míří pořád na tentýž soubor, takže LCP zůstává eager. Má-li článek
// YouTube `video` I xPosts, hero patří YouTube a fasády X jdou níž bez fotky.
const heroVeXFacade = !videoId && xEmbedy.length > 0 && Boolean(heroSrc);
// LCP hero (obrázek i YouTube facade) se objevuje až v <body> — jediný
// preload v <head> ho pustí ke stažení hned. Míří na tentýž kandidát,
// který si <picture> níž vybere (WebP srcset > WebP > JPG/ytimg).
const heroPreload = preloadHeroObrazku({
  src: heroLcpSrc,
  srcset: heroWebp ? undefined : heroSrcset,
  webp: heroWebp,
  webpSrcset: heroWebpSrcset,
  sizes: heroSizes,
});
// Brandovaný OG generuje prebuild i pro video články (z YouTube náhledu),
// syrový ytimg náhled je jen záchranná síť, kdyby soubor chyběl.
const brandedOg = `/images/og/${article.id}.jpg`;
const ogImage = fs.existsSync(`public${brandedOg}`)
  ? new URL(brandedOg, Astro.site).href
  : videoId ? `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`
  : image ? new URL(image, Astro.site).href : undefined;

const others = (await getCollection('clanky', ({ data, id }) => !data.draft && id !== article.id))
  .sort(compareArticlesByDateDescThenId);
const related = [
  ...others.filter((c) => c.data.category === category),
  ...others.filter((c) => c.data.category !== category),
].slice(0, 3);

// Chronologická navigace (novější/starší)
const chrono = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort(compareArticlesByDateDescThenId);
const idx = chrono.findIndex((c) => c.id === article.id);
const newer = idx > 0 ? chrono[idx - 1] : null;
const older = idx >= 0 && idx < chrono.length - 1 ? chrono[idx + 1] : null;

const autori = [
  { '@type': 'Person', name: 'Daniel Soukup', url: new URL('/o-nas/', Astro.site).href },
  { '@type': 'Person', name: 'Sam', url: new URL('/o-nas/', Astro.site).href },
];

const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
const audioLd = vytvorAudioObject(audio, {
  site: Astro.site,
  articleUrl,
  title,
  description,
});

const videoLd = videoId && {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [`https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`],
  uploadDate: date.toISOString(),
  duration: isoDuration(videoLength),
  contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
  embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
  inLanguage: 'cs',
  publisher: {
    '@type': 'Organization',
    name: 'REALTECH CZ',
    url: Astro.site?.href,
  },
};

const jsonLd = pripojAudioKClanku({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'cs',
  mainEntityOfPage: articleUrl,
  image: [ogImage ?? new URL('/og-default.jpg', Astro.site).href],
  author: autori,
  publisher: {
    '@type': 'Organization',
    name: 'REALTECH CZ',
    url: Astro.site?.href,
    logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href, width: 180, height: 180 },
  },
}, audioLd);
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Novinky', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Články', item: new URL('/clanky/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: title, item: articleUrl },
  ],
};
---
<Base
  title={seoTitle ?? seoTitulek(title, { zachovatCely: true })}
  ogTitle={`${title} — REALTECH CZ`}
  description={description}
  image={ogImage}
  ogType="article"
>
  {heroPreload && (
    <link
      rel="preload"
      as="image"
      href={heroPreload.href}
      imagesrcset={heroPreload.imagesrcset}
      imagesizes={heroPreload.imagesizes}
      type={heroPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <script type="application/ld+json" set:html={jsonLdText(jsonLd)} slot="head" is:inline />
  <script type="application/ld+json" set:html={jsonLdText(breadcrumbLd)} slot="head" is:inline />
  {videoLd && <script type="application/ld+json" set:html={jsonLdText(videoLd)} slot="head" is:inline />}
  {audioLd && <script type="application/ld+json" set:html={jsonLdText(audioLd)} slot="head" is:inline />}
  <meta property="article:published_time" content={date.toISOString()} slot="head" />
  {updated && <meta property="article:modified_time" content={updated.toISOString()} slot="head" />}
  <meta property="article:section" content={category} slot="head" />
  <div class="read-progress" aria-hidden="true"><span></span></div>
  <div class="article-page">
    <div class="wrap">

      <div class="article-head">
        <div class="lower-third">
          <a class="tag" href={`/temata/${slugify(category)}/`}>{category}</a>
          {zprava && <span class="tag tag-zprava">Zpráva</span>}
          <time class="time" datetime={date.toISOString().slice(0, 10)}>{dateStr}</time>
          {updatedStr && <span class="time">AKTUALIZOVÁNO {updatedStr}</span>}
          <span class="time">ČTENÍ {readMinutes} MIN</span>
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>

      {/*
        Hlavní cover není dekorace — nemá aria-hidden a čtečka o něm s alt=""
        mlčela. Frontmatter vlastní alt obrázku nemá, tak nese titulek článku.
        Platí to i pro poster ve video fasádě níže: je to LCP hero článku
        (eager, fetchpriority=high), ne dekorativní miniatura. aria-label
        tlačítka pojmenovává ovládací prvek, o obrázku samotném ale čtečka
        s alt="" mlčela (živě ověřeno na /clanky/starlink-mini-vs-standard/).
        Totéž platí pro cover ve fasádě X níž — i tam je to LCP hero článku.
      */}
      {!videoId && !heroVeXFacade && heroSrc && (
        <div class="article-hero">
          <picture>
            {heroWebpSrcset && <source srcset={heroWebpSrcset} sizes={heroSizes} type="image/webp" />}
            {!heroWebpSrcset && heroWebp && <source srcset={heroWebp} type="image/webp" />}
            <img src={heroLcpSrc} srcset={heroWebp ? undefined : heroSrcset} sizes={(!heroWebp && heroSrcset) ? heroSizes : undefined} alt={title} width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" />
          </picture>
        </div>
      )}

      {videoId && (
        <div
          class="video-embed youtube-facade"
          data-youtube-facade
          data-video-id={videoId}
          data-video-title={`Video: ${title}`}
        >
          <button
            type="button"
            class="youtube-facade-button"
            aria-label={`Přehrát video: ${title}`}
          >
            {heroSrc && (
              <picture>
                {heroWebpSrcset && <source srcset={heroWebpSrcset} sizes={heroSizes} type="image/webp" />}
                {!heroWebpSrcset && heroWebp && <source srcset={heroWebp} type="image/webp" />}
                <img src={heroLcpSrc} srcset={heroWebp ? undefined : heroSrcset} sizes={(!heroWebp && heroSrcset) ? heroSizes : undefined} alt={title} width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" />
              </picture>
            )}
            <span class="youtube-facade-play" aria-hidden="true">
              <svg viewBox="0 0 68 48"><path d="M66.5 7.5a8 8 0 0 0-5.6-5.7C56 0 34 0 34 0S12 0 7.1 1.8a8 8 0 0 0-5.6 5.7C0 12.5 0 24 0 24s0 11.5 1.5 16.5a8 8 0 0 0 5.6 5.7C12 48 34 48 34 48s22 0 26.9-1.8a8 8 0 0 0 5.6-5.7C68 35.5 68 24 68 24s0-11.5-1.5-16.5z"/><path class="youtube-facade-play-triangle" d="m27 34 18-10-18-10z"/></svg>
            </span>
          </button>
        </div>
      )}

      {video && (
        <div class="article-videobar">
          <span class="mono"><span class="live-dot"></span>K tomuto článku existuje video{videoLength && ` · ${videoLength}`}</span>
          <a href={video} class="yt-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
            Přehrát na YouTube
          </a>
        </div>
      )}

      {/*
        Oficiální embed X, click-to-load — stejný princip jako YouTube fasáda
        výš. První HTML nesmí poslat nic na platform.twitter.com / twimg;
        widget se vloží až po kliknutí (viz src/lib/x-embed.js). Soubor videa
        zůstává u X — nestahujeme, nerehostujeme, žádné video src z twimg.
        První fasáda nese cover článku (lokální soubor, LCP hero — eager,
        fetchpriority=high) s malým kulatým play — ŽÁDNÝ červený YT obdélník,
        ať to nevypadá jako YouTube. Bez coveru zůstane světlý panel v barvách
        webu (--surface/--ink) — černo-červené horory Maky zakázal.
        Fallback odkaz „Otevřít na X“ stojí mimo fasádu, takže přežije
        i výměnu obsahu fasády a funguje, když widget selže.
      */}
      {xEmbedy.map((post, poradi) => (
        <div class="x-embed">
          <div
            class={`x-facade${poradi === 0 && heroVeXFacade ? ' x-facade-photo' : ''}`}
            data-x-facade
            data-x-post-id={post.id}
            data-x-post-href={post.href}
            data-x-post-title={`Příspěvek @${post.ucet} na X`}
          >
            {poradi === 0 && heroVeXFacade ? (
              <button
                type="button"
                class="x-facade-button x-facade-button-photo"
                aria-label={`Načíst video z příspěvku @${post.ucet} na síti X`}
              >
                <picture>
                  {heroWebpSrcset && <source srcset={heroWebpSrcset} sizes={heroSizes} type="image/webp" />}
                  {!heroWebpSrcset && heroWebp && <source srcset={heroWebp} type="image/webp" />}
                  <img src={heroLcpSrc} srcset={heroWebp ? undefined : heroSrcset} sizes={(!heroWebp && heroSrcset) ? heroSizes : undefined} alt={title} width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" />
                </picture>
                <span class="x-facade-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5.3v13.4L19 12z"/></svg>
                </span>
                <span class="x-facade-badge mono" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  Video z příspěvku @{post.ucet}
                </span>
              </button>
            ) : (
              <button
                type="button"
                class="x-facade-button"
                aria-label={`Načíst video z příspěvku @${post.ucet} na síti X`}
              >
                <span class="x-facade-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </span>
                <span class="x-facade-title">Video z příspěvku @{post.ucet}</span>
                <span class="x-facade-note mono">Kliknutím se načte oficiální vložený příspěvek ze sítě X</span>
              </button>
            )}
          </div>
          <p class="x-embed-fallback mono">
            Nenačítá se? <a href={post.webHref} target="_blank" rel="noopener">Otevřít na X →</a>
          </p>
        </div>
      ))}

      <AudioPrehled audio={audio} />

      <div class="article-layout">
        <div class="article-body">
          <Content />
        </div>
        <aside class="article-aside">
          <p class="mono">V článku</p>
          <ul class="article-aside-meta">
            <li><a href={`/temata/${slugify(category)}/`}>{category}</a></li>
            <li><time datetime={date.toISOString().slice(0, 10)}>{dateStr}</time></li>
            <li>Čtení {readMinutes} min</li>
          </ul>
          <p class="mono">Sdílej dál</p>
          <div class="share-btns">
            <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} target="_blank" rel="noopener">X</a>
            <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} target="_blank" rel="noopener">Facebook</a>
            <button class="share-btn copy-link" data-url={new URL(Astro.url.pathname, Astro.site).href}>Kopírovat odkaz</button>
          </div>
          {related.length > 0 && (
            <>
              <p class="mono">Další reporty</p>
              <ul class="article-aside-related">
                {related.map((c) => (
                  <li><a href={`/clanky/${c.id}/`}>{c.data.title}</a></li>
                ))}
              </ul>
            </>
          )}
        </aside>
      </div>

      {/*
        Článek BEZ videa dosud nenabízel ke kanálu nic konkrétního — jen obecné
        „kdo jsme" v `author-box` na konci. A takových článků je většina.
        ⚠️ Text musí říkat KONKRÉTNĚ, co na kanálu je. První verze zněla
        „na kanálu ale měříme totéž v obraze" a Deny se hned zeptal, co to
        znamená — nic. Vágní věta v tónu značky je pořád vágní věta.
        Hardcoded počet videí (kdysi 82 z YouTube API) zastará hned po dalším
        vydání — proto jen říkáme, že na kanálu jsou další videa o technice a AI.
        Převzato z návrhu Claude Design z 30. 7. 2026 — `reference/design-2026-07/`,
        varianta „video není".
        Z1003: pruh nesmí sedět mezi hero a prvním odstavcem — působí to jako
        vložená reklama a přerušuje čtení. Výzva zůstává, ale až po textu.
        Článek s embedem X video má (jen ne naše) — „K tomuhle článku video
        není" by lhal, proto se výzva u xPosts neukazuje.
      */}
      {!video && xEmbedy.length === 0 && (
        <div class="article-videobar">
          <span class="mono">K tomuhle článku video není. Na kanálu máme další videa o technice a AI</span>
          <a href="https://www.youtube.com/@realtech-cz?sub_confirmation=1" class="yt-btn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
            Odebírat kanál
          </a>
        </div>
      )}

      <div class="article-share">
        <span class="mono">// Sdílej dál</span>
        <div class="share-btns">
          <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} target="_blank" rel="noopener">X</a>
          <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href)}`} target="_blank" rel="noopener">Facebook</a>
          <button class="share-btn copy-link" data-url={new URL(Astro.url.pathname, Astro.site).href}>Kopírovat odkaz</button>
        </div>
      </div>

      <div class="author-box">
        <div class="ab-logo" aria-hidden="true">
          <span class="real">REAL</span><span class="tech">TECH</span>
        </div>
        <div class="ab-body">
          <p>Jsme <strong>Deny a Sam</strong>. Točíme videa a píšeme o AI a techu — bez marketingových řečí, česky a jen když je co říct. Nejvíc toho najdeš na našem YouTube.</p>
          <div class="ab-actions">
            <a href="https://www.youtube.com/@realtech-cz?sub_confirmation=1" class="yt-btn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg>
              Odebírat na YouTube
            </a>
            <a href="/o-nas/" class="btn-ghost">Víc o nás</a>
          </div>
        </div>
      </div>

      {related.length > 0 && (
        <div class="related">
          <div class="section-head">
            <h2>Další reporty</h2>
            <a href="/clanky/">Všechny →</a>
          </div>
          <div class="grid">
            {related.map((c) => <ArticleCard article={c} />)}
          </div>
        </div>
      )}

      <nav class="article-nav" aria-label="Další čtení">
        {older ? (
          <a href={`/clanky/${older.id}/`} class="an-item an-prev">
            <span class="mono">← Starší</span>
            <span class="an-title">{older.data.title}</span>
          </a>
        ) : <span />}
        {newer ? (
          <a href={`/clanky/${newer.id}/`} class="an-item an-next">
            <span class="mono">Novější →</span>
            <span class="an-title">{newer.data.title}</span>
          </a>
        ) : <span />}
      </nav>

      <div class="article-back">
        <a href="/clanky/" class="btn-ghost">← Zpět na články</a>
      </div>

    </div>
  </div>

  <script>
    import { inicializujYoutubeFacades } from '../../lib/youtube-facade.js';
    import { inicializujXFacades } from '../../lib/x-embed.js';

    // Kotvy u nadpisů — klik zkopíruje odkaz přímo na sekci (standard u velkých webů).
    // Stejný helper jako rehype plugin, včetně dedupu (Z1207) — jinak by tlačítko
    // „#“ u druhé stejné sekce zkopírovalo odkaz na první.
    import { asciiHeadingId, nextUniqueHeadingId } from '../../lib/heading-id.js';

    const seen = new Map<string, number>();
    document.querySelectorAll<HTMLElement>('.article-body h2, .article-body h3').forEach((h) => {
      if (!h.id) h.id = nextUniqueHeadingId(asciiHeadingId(h.textContent ?? ''), seen);
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.className = 'heading-anchor';
      a.textContent = '#';
      a.setAttribute('aria-label', `Odkaz na sekci ${h.textContent}`);
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const url = `${location.origin}${location.pathname}#${h.id}`;
        history.replaceState(null, '', `#${h.id}`);
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        navigator.clipboard?.writeText(url).then(() => {
          a.textContent = '✓';
          setTimeout(() => { a.textContent = '#'; }, 1500);
        }).catch(() => {});
      });
      h.appendChild(a);
    });

    const bar = document.querySelector('.read-progress span') as HTMLElement | null;
    const onScroll = () => {
      if (!bar) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((copyBtn) => {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') ?? location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyBtn.textContent = 'Zkopírováno ✓';
          setTimeout(() => { copyBtn.textContent = 'Kopírovat odkaz'; }, 2000);
        } catch {
          location.href = url;
        }
      });
    });

    inicializujYoutubeFacades();
    inicializujXFacades();
  </script>
</Base>
