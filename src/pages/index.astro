---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { slugify } from '../lib/slugify.js';
import { textNaHeroObrazku } from '../lib/hero-overlay.js';
import { preloadHeroObrazku } from '../lib/hero-preload.js';
import { formatCalendarDateCs } from '../lib/calendarDate.js';

const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pruvodci = all.filter((c) => c.data.evergreen).slice(0, 3);

// Hero = článek označený featured: true, jinak nejnovější.
// featured drží hero max 14 dní od data článku, pak už nesmí přebít novinky.
const FEATURED_MAX_AGE = 14 * 24 * 60 * 60 * 1000;
const hero = all.find((c) => c.data.featured && Date.now() - c.data.date.valueOf() <= FEATURED_MAX_AGE) ?? all[0];
const candidates = all.filter((c) => c.id !== hero?.id).slice(0, 9);
const rail = candidates.slice(0, 3);
const rest = candidates.slice(3, 9);
const categories = [...new Set(all.map((c) => c.data.category))];

const dateStr = hero ? formatCalendarDateCs(hero.data.date) : undefined;
const heroOverlay = hero ? textNaHeroObrazku(hero.data) : '';

const heroVideoId = hero?.data.video?.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{11})/)?.[1];
const heroThumb = heroVideoId ? `https://i.ytimg.com/vi/${heroVideoId}/maxresdefault.jpg` : hero?.data.image;
// Na mobilu stačí 640px varianta — LCP
const heroSmall = !heroVideoId && hero?.data.image ? hero.data.image.replace(/\.jpg$/, '-640.jpg') : null;
const heroSrcset = heroSmall && fs.existsSync(`public${heroSmall}`)
  ? `${heroSmall} 640w, ${heroThumb} 1280w`
  : undefined;
const heroWebp = !heroVideoId && hero?.data.image ? hero.data.image.replace(/\.jpg$/, '.webp') : null;
const heroWebpSmall = heroWebp?.replace(/\.webp$/, '-640.webp');
const heroWebpSrcset = heroWebp && fs.existsSync(`public${heroWebp}`) && fs.existsSync(`public${heroWebpSmall}`)
  ? `${heroWebpSmall} 640w, ${heroWebp} 1280w`
  : undefined;
const HERO_SIZES = '(max-width: 900px) 100vw, 40vw';
// LCP hero je až v <body> — jediný preload v <head> ho pustí ke stažení hned.
// WebP jen když se reálně použije (tj. existuje i 640 varianta a <source>
// se vůbec vyrenderuje) — jinak by se preloadoval soubor, který <picture>
// nevybere, a hero by se stáhlo dvakrát.
const heroPreload = preloadHeroObrazku({
  src: heroThumb,
  srcset: heroSrcset,
  webp: heroWebpSrcset ? heroWebp : undefined,
  webpSrcset: heroWebpSrcset,
  sizes: HERO_SIZES,
});

// Nejnovější videa: primárně YT RSS (build-time), fallback statický snapshot
// v src/data/videos.json (YouTube RSS občas vrací 404 — snapshot aktualizuje Kepler
// při publikacích / po vydání nového videa).
import videosSnapshot from '../data/videos.json';
const decode = (s) => s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
let videos = [];
try {
  const res = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCwWvw3SkWgfDinhnAHpceeA', { signal: AbortSignal.timeout(8000) });
  if (res.ok) {
    const xml = await res.text();
    videos = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)]
      .map((m) => ({
        id: m[1].match(/<yt:videoId>([^<]+)/)?.[1],
        title: m[1].match(/<title>([^<]+)/)?.[1],
      }))
      .filter((v) => v.id && v.title && !/#?shorts/i.test(v.title))
      .slice(0, 3)
      .map((v) => ({ ...v, title: decode(v.title) }));
  }
} catch { /* fallthrough na snapshot */ }
if (videos.length === 0) videos = videosSnapshot;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      description: 'Tech novinky a analýzy bez marketingových řečí.',
      inLanguage: 'cs',
      publisher: { '@id': `${Astro.site?.href}#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site?.href}#org`,
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      email: 'info@realtech.cz',
      logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href, width: 180, height: 180 },
      sameAs: ['https://www.youtube.com/@realtech-cz'],
    },
  ],
};
---
<Base title="REALTECH CZ — Tech novinky a analýzy">
  {heroPreload && (
    <link
      rel="preload"
      as="image"
      href={heroPreload.href}
      imagesrcset={heroPreload.imagesrcset}
      imagesizes={heroPreload.imagesizes}
      type={heroPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <div class="ticker" aria-label="Nejnovější články">
    <span class="ticker-label"><span class="live-dot"></span>ŽIVĚ</span>
    <div class="ticker-viewport">
      <div class="ticker-track">
        {all.slice(0, 6).map((c) => (
          <a href={`/clanky/${c.id}/`}>{c.data.title}</a>
        ))}
        {/* Druhá sada je JEN pro plynulou smyčku — animace posouvá o -50 %,
            takže bez zdvojení by pruh na konci cyklu poskočil. Pro čtečky
            i klávesnici je skrytá, aby se odkazy nečetly a neprocházely
            dvakrát (to byla oprávněná výtka Z10032, která pohyb zrušila). */}
        {all.slice(0, 6).map((c) => (
          <a href={`/clanky/${c.id}/`} aria-hidden="true" tabindex="-1">{c.data.title}</a>
        ))}
      </div>
    </div>
  </div>

  {hero && (
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="lower-third">
              <span class="tag">{hero.data.category}</span>
              <time class="time" datetime={hero?.data.date.toISOString().slice(0, 10)}>{dateStr}</time>
            </div>
            <h1>{hero.data.title}</h1>
            <p class="lead">{hero.data.description}</p>
            <div class="hero-actions">
              <a href={`/clanky/${hero.id}/`} class="btn-primary">Přečíst analýzu</a>
              {hero.data.video && (
                <a href={hero.data.video} class="btn-ghost">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  Video{hero.data.videoLength && ` · ${hero.data.videoLength}`}
                </a>
              )}
            </div>
          </div>
          <a href={hero.data.video ?? `/clanky/${hero.id}/`} class="hero-visual">
            {heroThumb && (
              <picture>
                {heroWebpSrcset && <source srcset={heroWebpSrcset} sizes={HERO_SIZES} type="image/webp" />}
                <img src={heroThumb} srcset={heroSrcset} sizes={heroSrcset ? HERO_SIZES : undefined} alt={hero.data.title} width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" />
              </picture>
            )}
            {heroThumb && <span class="shade"></span>}
            <span class="rec"><span class="live-dot"></span>REALTECH</span>
            {heroOverlay && <span class="headline-mark">{heroOverlay}</span>}
            {hero.data.videoLength && <span class="tc">TC {hero.data.videoLength}</span>}
            {hero.data.video && <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>}
          </a>
        </div>
        {rail.length > 0 && (
          <aside class="hero-rail" aria-label="Další reporty">
            <p class="hero-rail-label mono">Další reporty</p>
            <ol class="hero-rail-list">
              {rail.map((article) => (
                <li>
                  <a href={`/clanky/${article.id}/`} class="hero-rail-item">
                    <span class="hero-rail-title">{article.data.title}</span>
                    <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatCalendarDateCs(article.data.date)}</time>
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>
    </section>
  )}

  <section class="articles">
    <div class="wrap">
      <div class="section-head">
        <h2>Poslední reporty</h2>
        <a href="/clanky/">Všechny články →</a>
      </div>
      <div class="grid">
        {rest.map((article) => <ArticleCard article={article} />)}
      </div>

      {pruvodci.length > 0 && (
        <div class="video-strip">
          <div class="section-head">
            <h2>Průvodci a srovnání</h2>
            <a href="/temata/site/">Téma Sítě →</a>
          </div>
          <div class="grid">
            {pruvodci.map((article) => <ArticleCard article={article} />)}
          </div>
        </div>
      )}

      {videos.length > 0 && (
        <div class="video-strip">
          <div class="section-head">
            <h2>Nejnovější videa</h2>
            <a href="https://www.youtube.com/@realtech-cz">Celý kanál →</a>
          </div>
          <div class="video-grid">
            {videos.map((v) => (
              <a class="video-card" href={`https://www.youtube.com/watch?v=${v.id}`}>
                <span class="vc-thumb">
                  <img src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                  <span class="vc-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
                </span>
                <span class="vc-title">{v.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="topics">
        <span class="mono">// Témata</span>
        <div class="cat-filter">
          {categories.map((cat) => (
            <a class="chip" href={`/temata/${slugify(cat)}/`}>{cat}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

</Base>
