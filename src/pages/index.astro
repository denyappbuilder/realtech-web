---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroheroCta from '../components/HeroheroCta.astro';
import RtPlayer from '../components/RtPlayer.astro';
import { slugify } from '../lib/slugify.js';
import { articleLead } from '../lib/article-lead.js';
import { preloadHeroObrazku } from '../lib/hero-preload.js';
import { formatCalendarDateCs } from '../lib/calendarDate.js';
import { nahledRailu, webpSrcsetZDerivatu, HERO_RAIL_SIZES, HOMEPAGE_HERO_SIZES, KARTA_SIZES, KARTA_SIZES_HOME_COMPACT } from '../lib/karta-nahled.js';
import { compareArticlesByDateDescThenId } from '../lib/article-order.js';
import { videaSNahledem } from '../lib/video-pasek-nahled.js';

// Kolo 45: stejný komparátor jako archiv, RSS, témata a chrono navigace
// článku (b.date - a.date, při shodě id). Dva články se stejným časem
// vydání (živě 20. 9. 2026: AGENTS.md i Custom GPT, oba 10:04) dřív řadil
// jen podle data — kdo bude hero, rozhodovalo pořadí, v jakém content layer
// soubory načetl (paralelně, ne abecedně). Archiv i „Novější →“ přitom
// ukazovaly pořadí podle id: úvodka mohla mít jiný hero než první karta
// archivu. Řazení dál vede čas vydání; id je jen poslední rozřešení.
const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort(compareArticlesByDateDescThenId);

const pruvodci = all.filter((c) => c.data.evergreen).slice(0, 3);

// Hero = poslední vydaný (date vč. času). Date-only = půlnoc UTC, takže
// stejný den s pozdějším timestampem vyhraje; featured ani slug nepinují.
const hero = all[0];
const candidates = all.filter((c) => c.id !== hero?.id).slice(0, 9);
const rail = candidates.slice(0, 3);
const rest = candidates.slice(3, 9);
// Rail je jen desktop (≥ 901px); pod tím ho CSS nekreslí, takže by tři
// nejnovější články po heru z úvodky úplně zmizely a „Poslední reporty"
// by začínaly až 5. článkem (živě 4. 9. 2026: Astra vyšla, Critical
// a Gemini 3.8 chyběly na mobilu). Proto jdou ty tři i do mřížky jako
// karty s .card-rail-mobile, které CSS od 901px skryje — desktop zůstává
// hero + rail + 6 karet, mobil hero + 9 karet, oboje chronologicky.
const railCards = rail;
// Kolo 42: rail dostává <picture> + sizes jako karty (nahledRailu), ne holý
// <img src=-640.webp> — byl to jediný náhled na webu bez srcset.
const railPolozky = rail.map((article) => ({ article, nahled: nahledRailu(article.data) }));
const categories = [...new Set(all.map((c) => c.data.category))];
// Kolo 52: „Mimo AI“ — tři nejnovější články mimo AI Report / AI Agenti,
// které už nejsou v heru ani v prvních devíti kartách. Vizuálně vyrovnává
// převahu AI (60 % obsahu) a dává Mobilům, Vesmíru, Sítím a Dronům místo.
const AI_KATEGORIE = new Set(['AI Report', 'AI Agenti']);
const naUvodce = new Set([hero?.id, ...candidates.map((c) => c.id)]);
const mimoAi = all.filter((c) => !AI_KATEGORIE.has(c.data.category) && !naUvodce.has(c.id)).slice(0, 3);

const dateStr = hero ? formatCalendarDateCs(hero.data.date) : undefined;
// Kolo 27: od 90 znaků dostal h1 menší desktopový stupeň (.h1-dlouhy v CSS).
// 102znakový titulek měl živě 9–10 řádků při 3.1rem a cover plaval uprostřed
// dvakrát vyššího sloupce.
// Kolo 33: práh 75. Živě 9. 9. 2026 měl 76znakový titulek Muse bez třídy
// 5 řádků na 1280px a 6 na 1024px (sloupec 553px proti coveru 275px —
// stejný 2× nepoměr jako v kole 27). Měření všech 102 titulků v živém
// heru: od ~75 znaků jde titulek při 3.1rem na 6–7 řádků na 1024px
// (5–7 na 1280px), s .h1-dlouhy na 4–5. Pod 75 drží 4–5 řádků i bez třídy.
const HERO_DLOUHY_TITULEK = 75;
const heroTitulekDlouhy = Boolean(hero && hero.data.title.length >= HERO_DLOUHY_TITULEK);
// Kolo 34: krátká zpráva (zprava: true) není analýza — karta i hlava
// článku ji značí chipem „Zpráva“, ale CTA úvodky slibovalo „Přečíst
// analýzu“ (živě 9. 9. 2026 u Muse). Text tlačítka sleduje frontmatter;
// hero-overlay.js zná oba texty, aby overlay CTA nezdvojil.
const heroJeZprava = Boolean(hero?.data.zprava);
const heroCta = heroJeZprava ? 'Přečíst zprávu' : 'Přečíst analýzu';

const heroVideoId = hero?.data.video?.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{11})/)?.[1];
// Lokální cover má přednost i u video článku — YouTube maxresdefault
// (~170 KB JPEG) je jen fallback, když cover v public/ opravdu není.
// Stejná volba jako karta (nahledKarty.hasLocalThumb) a facade článku;
// dřív video hero vždy táhlo YT JPEG a lokální -640.webp ležel ladem.
const heroImage = hero?.data.image;
const heroMaLokalniCover = !!heroImage && fs.existsSync(`public${heroImage}`);
const heroThumb = heroVideoId && !heroMaLokalniCover
  ? `https://i.ytimg.com/vi/${heroVideoId}/maxresdefault.jpg`
  : hero?.data.image;
// Na mobilu stačí 640px varianta — LCP
const heroSmall = heroMaLokalniCover && heroImage.endsWith('.jpg') ? heroImage.replace(/\.jpg$/, '-640.jpg') : null;
const heroSrcset = heroSmall && fs.existsSync(`public${heroSmall}`)
  ? `${heroSmall} 640w, ${heroThumb} 1280w`
  : undefined;
const heroWebp = heroMaLokalniCover && heroImage.endsWith('.jpg') ? heroImage.replace(/\.jpg$/, '.webp') : null;
const heroWebpSmall = heroWebp?.replace(/\.webp$/, '-640.webp');
const heroHasWebp = !!heroWebp && fs.existsSync(`public${heroWebp}`);
// Kolo 39: 960w mezi 640 a 1280 (viz karta-nahled.js) — hero na mobilu
// DPR 2 (342 px) a v desktop slotu 550 px bral plných 1280.
const heroWebpSrcset = heroHasWebp && heroWebpSmall && fs.existsSync(`public${heroWebpSmall}`)
  ? webpSrcsetZDerivatu(heroWebp, (cesta) => fs.existsSync(cesta))
  : undefined;
// fetchpriority=high na <img> spekulativně stáhne src dřív než <source>.
// Když WebP existuje, src musí být WebP — jinak LCP zůstane .jpg.
const heroLcpSrc = heroHasWebp ? heroWebp : heroThumb;
const heroOgSoubor = hero ? `public/images/og/${hero.id}.jpg` : null;
const heroOg = heroOgSoubor && fs.existsSync(heroOgSoubor)
  ? `/images/og/${hero.id}.jpg`
  : hero?.data.image;
// .wrap has 24px padding on each side; 100vw needlessly selects 1280w on mobile.
const HERO_SIZES = HOMEPAGE_HERO_SIZES;
// LCP hero je až v <body> — jediný preload v <head> ho pustí ke stažení hned.
// Míří na tentýž soubor jako <img src> (WebP, když derivát existuje).
const heroPreload = preloadHeroObrazku({
  src: heroLcpSrc,
  srcset: heroHasWebp ? undefined : heroSrcset,
  webp: heroHasWebp ? heroWebp : undefined,
  webpSrcset: heroWebpSrcset,
  sizes: HERO_SIZES,
});

// Nejnovější videa: primárně YT RSS (build-time), fallback statický snapshot
// v src/data/videos.json (YouTube RSS občas vrací 404 — snapshot aktualizuje Kepler
// při publikacích / po vydání nového videa).
import videosSnapshot from '../data/videos.json';
const decode = (s: string) => s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");
let videos: typeof videosSnapshot = [];
try {
  const res = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCwWvw3SkWgfDinhnAHpceeA', { signal: AbortSignal.timeout(8000) });
  if (res.ok) {
    const xml = await res.text();
    videos = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)]
      .map((m) => ({
        id: m[1].match(/<yt:videoId>([^<]+)/)?.[1],
        title: m[1].match(/<title>([^<]+)/)?.[1],
      }))
      .filter((v): v is { id: string; title: string } => Boolean(v.id && v.title && !/#?shorts/i.test(v.title)))
      .slice(0, 3)
      .map((v) => ({ ...v, title: decode(v.title) }));
  }
} catch { /* fallthrough na snapshot */ }
if (videos.length === 0) videos = videosSnapshot;
const videaPasek = await videaSNahledem(videos);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      description: 'Tech novinky a analýzy bez marketingových řečí.',
      inLanguage: 'cs',
      publisher: { '@id': `${Astro.site?.href}#org` },
      // Kolo 29: archiv čte ?q= (ArticleArchivePage, filtr z URL) — web
      // má vyhledávací URL, jen o ní JSON-LD neříkal.
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${new URL('/clanky/', Astro.site).href}?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site?.href}#org`,
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      email: 'info@realtech.cz',
      logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href, width: 180, height: 180 },
      sameAs: ['https://www.youtube.com/@realtech-cz'],
    },
  ],
};
// Video strip tahá i.ytimg.com/vi_webp/…/hq720.webp. Hero Flight 14 má lokální
// cover a homepage mp3 nenačítá — audio preconnect sem nepatří.
const preconnectYtimg = videos.length > 0;
// og:image úvodky je cover hero článku — og:image:alt nese jeho titulek,
// ne název webu (kolo 22). Bez coveru padá Base na /og-default.jpg + title.
const heroOgAlt = heroOg ? hero.data.title : undefined;
---
<Base title="REALTECH CZ — Tech novinky a analýzy" image={heroOg} imageAlt={heroOgAlt} preconnectYtimg={preconnectYtimg}>
  {heroPreload && (
    <link
      rel="preload"
      as="image"
      href={heroPreload.href}
      imagesrcset={heroPreload.imagesrcset}
      imagesizes={heroPreload.imagesizes}
      type={heroPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <div class="edition-heading wrap"><p>Technologie v souvislostech.</p><a href="/clanky/">Prohlédnout archiv <span aria-hidden="true">→</span></a></div>

  {hero && (
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="lower-third">
              {/* Kolo 35: štítek kategorie je proklik na téma jako v hlavě
                  článku (a.tag, 44px cíl) — holý <span> byl slepý. */}
              <a class="tag" href={`/temata/${slugify(hero.data.category)}/`}>{hero.data.category}</a>
              {heroJeZprava && <span class="tag tag-zprava">Zpráva</span>}
              <time class="time" datetime={hero?.data.date.toISOString().slice(0, 10)}>{dateStr}</time>
            </div>
            <h1 class:list={[{ 'h1-dlouhy': heroTitulekDlouhy }]}><a href={`/clanky/${hero.id}/`}>{hero.data.title}</a></h1>
            <p class="lead">{articleLead(hero.data.description, hero.body)}</p>
            {hero.data.audio && <RtPlayer audio={hero.data.audio} seed={hero.id} class="hero-player" />}
            <div class="hero-actions">
              <a href={`/clanky/${hero.id}/`} class="btn-primary">{heroCta}</a>
              {hero.data.video && (
                <a href={hero.data.video} class="btn-ghost">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  Video{hero.data.videoLength && ` · ${hero.data.videoLength}`}
                </a>
              )}
            </div>
          </div>
          {/*
            Kolo 29: na stejný cíl vedly tři odkazy za sebou — h1, „Přečíst
            analýzu“ a cover (s videem cover + „Video · 12:34“ na YouTube).
            Čtečka slyšela titulek třikrát (alt coveru = h1) a klávesnice
            procházela tři zastávky. Cover zůstává odkaz pro myš, ale pro
            čtečku i tabulátor je dekorace: aria-hidden + tabindex=-1
            (axe aria-hidden-focus s tabindex=-1 prochází).
            Jméno i cíl nese h1 a CTA, video tlačítko .btn-ghost.

            Kolo 37: alt coveru je titulek článku, ne "" (živě 12. 9. 2026
            byl LCP obrázek úvodky jediný cover na webu bez altu — karty
            i hlava článku titulek nesou). Pro čtečku se nic nemění:
            aria-hidden na odkazu výš schová i alt, takže titulek se
            třikrát nečte. Alt slouží tomu, co aria-hidden neovlivní —
            vyhledávačům obrázků, čtenáři s vypnutými obrázky nebo
            spadlým CDN, kteří jinak vidí prázdný rám 1280×720.
          */}
          <a href={hero.data.video ?? `/clanky/${hero.id}/`} class="hero-visual" tabindex="-1" aria-hidden="true">
            {heroThumb && (
              <picture>
                {heroWebpSrcset && <source srcset={heroWebpSrcset} sizes={HERO_SIZES} type="image/webp" />}
                {!heroWebpSrcset && heroHasWebp && <source srcset={heroWebp} type="image/webp" />}
                <img src={heroLcpSrc} srcset={heroHasWebp ? undefined : heroSrcset} sizes={(!heroHasWebp && heroSrcset) ? HERO_SIZES : undefined} alt={hero.data.title} width="1280" height="720" loading="eager" decoding="async" fetchpriority="high" />
              </picture>
            )}

            {hero.data.video && <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>}
          </a>
        </div>
        {rail.length > 0 && (
          <aside class="hero-rail" aria-label="Další reporty">
            <p class="hero-rail-label mono">Další reporty</p>
            <ol class="hero-rail-list">
              {railPolozky.map(({ article, nahled }) => (
                <li>
                  <a href={`/clanky/${article.id}/`} class="hero-rail-item">
                    {/*
                      alt="" zůstává: jméno odkazu nese viditelný
                      .hero-rail-title hned vedle, alt={title} by ho zdvojil
                      („Titulek Titulek“) — stejné pravidlo jako .vc-thumb níž.
                      Kolo 44: i aria-hidden jako .vc-thumb — prázdný alt bez
                      něj některé čtečky hlásí jako „obrázek“ bez jména.
                    */}
                    {nahled && (
                      <picture>
                        {nahled.webpSrcset && <source srcset={nahled.webpSrcset} sizes={HERO_RAIL_SIZES} type="image/webp" />}
                        {!nahled.webpSrcset && nahled.webp && <source srcset={nahled.webp} type="image/webp" />}
                        <img src={nahled.src} alt="" aria-hidden="true" width={nahled.width} height={nahled.height} loading="lazy" decoding="async" />
                      </picture>
                    )}
                    <span class="hero-rail-copy">
                      <span class="hero-rail-category">{article.data.category}</span>
                      <span class="hero-rail-title">{article.data.title}</span>
                      <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatCalendarDateCs(article.data.date)}</time>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>
    </section>
  )}

  <section class="articles">
    <div class="wrap">
      <nav class="topic-navigation" aria-label="Témata">
        <a class="topic-navigation-all" href="/temata/">Prozkoumat témata <span aria-hidden="true">→</span></a>
        <div>
          {categories.map((cat) => <a href={`/temata/${slugify(cat)}/`}>{cat}</a>)}
        </div>
      </nav>
      <div class="section-head">
        <h2>Poslední reporty</h2>
        <a href="/clanky/">Všechny články →</a>
      </div>
      <div class="grid latest-reports">
        {railCards.map((article, index) => <ArticleCard article={article} class="card-rail-mobile" sizes={index === 0 ? KARTA_SIZES : KARTA_SIZES_HOME_COMPACT} />)}
        {rest.map((article) => <ArticleCard article={article} sizes={KARTA_SIZES_HOME_COMPACT} />)}
      </div>

      {mimoAi.length > 0 && (
        <div class="mimo-ai">
          <div class="section-head">
            <h2>Mimo AI</h2>
            <a href="/temata/">Všechna témata →</a>
          </div>
          <div class="grid mimo-ai-grid">
            {mimoAi.map((article) => <ArticleCard article={article} sizes={KARTA_SIZES_HOME_COMPACT} />)}
          </div>
        </div>
      )}

      {/*
        Kolo 48: web je trychtýř YouTube → články → Herohero. „Nejnovější
        videa“ stojí hned pod posledními reporty (dřív až za průvodci), aby
        nové video bylo druhá cesta z úvodky, ne poslední pásek před
        newsletterem. Náhledy jsou lazy — nad ohybem nic nepřibývá, LCP je
        dál cover hero článku (preload v <head> výš).
      */}
      {videaPasek.length > 0 && (
        <div class="video-strip films-section">
          <div class="section-head">
            <h2>Nejnovější videa</h2>
            <a href="https://www.youtube.com/@realtech-cz">Celý kanál →</a>
          </div>
          <div class="video-grid">
            {videaPasek.map((v) => (
              <a class="video-card" href={`https://www.youtube.com/watch?v=${v.id}`}>
                {/*
                  Náhled videa je dekorace: jméno odkazu dává viditelný
                  <span class="vc-title"> hned vedle. Prázdný alt smí zůstat
                  jen s aria-hidden — jinak by alt={v.title} zdvojil jméno
                  odkazu („Titulek Titulek").

                  Kolo 50: hq720 (nativní 16:9) jako WebP, JPEG jen fallback;
                  sddefault jen u videa bez 720p (video-pasek-nahled.js).
                */}
                <span class="vc-thumb">
                  <picture>
                    <source srcset={v.nahled.webpSrcset ?? v.nahled.webp} sizes="(max-width: 580px) calc(100vw - 48px), 341px" type="image/webp" />
                    <img src={v.nahled.jpg} alt="" aria-hidden="true" width={v.nahled.width} height={v.nahled.height} loading="lazy" decoding="async" />
                  </picture>
                  <span class="vc-play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
                </span>
                <span class="vc-title">{v.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {pruvodci.length > 0 && (
        <div class="video-strip guides-section">
          <div class="section-head">
            <h2>Průvodci a srovnání</h2>
            <a href="/temata/">Všechna témata →</a>
          </div>
          <div class="grid">
            {pruvodci.map((article) => <ArticleCard article={article} />)}
          </div>
        </div>
      )}

      {/*
        Kolo 48: třetí krok trychtýře — jeden klidný pás před newsletterem
        (ten dává Base za <main>). Žádný banner, žádné ceny ani sliby:
        Herohero zatím připravujeme a říká to i text (HeroheroCta.astro).
      */}
      <HeroheroCta
        nadpis="Návody a hlubší obsah chystáme na Herohero."
        text="Web i YouTube zůstávají zdarma. Herohero bude místo pro podporovatele a návody, které se do videa nevejdou — zatím ho připravujeme."
        odkaz="Co chystáme na Herohero"
      />
    </div>
  </section>

</Base>
