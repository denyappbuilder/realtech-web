---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';

const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Hero = článek označený featured: true, jinak nejnovější
const hero = all.find((c) => c.data.featured) ?? all[0];
const rest = all.filter((c) => c.id !== hero?.id).slice(0, 6);

const dateStr = hero?.data.date.toLocaleDateString('cs-CZ', {
  day: '2-digit', month: '2-digit', year: 'numeric',
});

const heroVideoId = hero?.data.video?.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([A-Za-z0-9_-]{11})/)?.[1];
const heroThumb = heroVideoId ? `https://i.ytimg.com/vi/${heroVideoId}/maxresdefault.jpg` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      description: 'Tech novinky a analýzy bez marketingových řečí.',
      inLanguage: 'cs',
      publisher: { '@id': `${Astro.site?.href}#org` },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site?.href}#org`,
      name: 'REALTECH CZ',
      url: Astro.site?.href,
      sameAs: ['https://www.youtube.com/@realtech-cz'],
    },
  ],
};
---
<Base title="REALTECH CZ — Tech novinky a analýzy">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  {hero && (
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="lower-third">
            <span class="tag">{hero.data.category}</span>
            <time class="time" datetime={hero?.data.date.toISOString().slice(0, 10)}>{dateStr}</time>
          </div>
          <h1>{hero.data.title}</h1>
          <p class="lead">{hero.data.description}</p>
          <div class="hero-actions">
            <a href={`/clanky/${hero.id}`} class="btn-primary">Přečíst analýzu</a>
            {hero.data.video && (
              <a href={hero.data.video} class="btn-ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                Video{hero.data.videoLength && ` · ${hero.data.videoLength}`}
              </a>
            )}
          </div>
        </div>
        <a href={hero.data.video ?? `/clanky/${hero.id}`} class="hero-visual" aria-label={hero.data.video ? `Přehrát video: ${hero.data.title}` : `Přečíst článek: ${hero.data.title}`}>
          {heroThumb && <img src={heroThumb} alt="" loading="eager" decoding="async" fetchpriority="high" />}
          {heroThumb && <span class="shade"></span>}
          <span class="rec"><span class="live-dot"></span>REALTECH</span>
          <span class="headline-mark">{hero.data.title}</span>
          {hero.data.videoLength && <span class="tc">TC {hero.data.videoLength}</span>}
          <span class="play"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
        </a>
      </div>
    </section>
  )}

  <section class="articles">
    <div class="wrap">
      <div class="section-head">
        <h2>Poslední reporty</h2>
        <a href="/clanky">Všechny články →</a>
      </div>
      <div class="grid">
        {rest.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

</Base>
