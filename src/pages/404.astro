---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';

const latest = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base
  title="404 — REALTECH CZ"
  description="Stránka nenalezena."
  robots="noindex, follow"
  includeCanonical={false}
>
  <div class="article-page">
    <div class="wrap notfound">
      <span class="mono">// CHYBA 404</span>
      <h1>Tahle stránka neexistuje.</h1>
      <p class="lead">Buď jsme ji smazali, nebo nikdy nebyla. Marketingová řeč by řekla „pracujeme na tom" — my říkáme: zkus to jinudy.</p>
      <div class="hero-actions">
        <a href="/" class="btn-primary">Na hlavní stránku</a>
        <a href="/clanky/" class="btn-ghost">Všechny články</a>
      </div>
    </div>
    <div class="wrap" style="margin-top: 48px;">
      <div class="section-head">
        <h2>Zatím mrkni na tohle</h2>
        <a href="/clanky/">Všechny →</a>
      </div>
      <div class="grid">
        {latest.map((article, index) => <ArticleCard article={article} priority={index === 0} />)}
      </div>
    </div>
  </div>
</Base>
