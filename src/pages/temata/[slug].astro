---
import { getCollection } from 'astro:content';
import TemaPage from '../../components/TemaPage.astro';
import { slugify } from '../../lib/slugify.js';

export async function getStaticPaths() {
  const all = await getCollection('clanky', ({ data }) => !data.draft);
  const categories = [...new Set(all.map((c) => c.data.category))];
  return categories.map((category) => ({
    params: { slug: slugify(category) },
    props: { category },
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
---
<TemaPage category={category} page={1} />
