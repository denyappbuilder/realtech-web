---
import { getCollection } from 'astro:content';
import { compareArticlesByDateDescThenId } from '../../lib/article-order.js';
import { formatCalendarDateCs } from '../../lib/calendarDate.js';
import { nahledKarty } from '../../lib/karta-nahled.js';
import { preloadHeroObrazku } from '../../lib/hero-preload.js';
import { seoTitulek } from '../../lib/seo-titulek.js';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slugify.js';
import { popisTematu } from '../../lib/tema-popis.js';

const all = (await getCollection('clanky', ({ data }) => !data.draft))
  .sort(compareArticlesByDateDescThenId);

// Pořadí témat = podle nejnovějšího článku (all je seřazené, Set drží první výskyt).
const temata = [...new Set(all.map((c) => c.data.category))].map((category) => {
  const clanky = all.filter((c) => c.data.category === category);
  const nejnovejsi = clanky[0];
  return {
    category,
    slug: slugify(category),
    pocet: clanky.length,
    nejnovejsi,
    nahled: nahledKarty(nejnovejsi.data.image),
  };
});

const pocetClankuText = (n) => (n === 1 ? '1 článek' : n < 5 ? `${n} články` : `${n} článků`);

// LCP na /temata/ je náhled první karty (fetchpriority=high jen i===0).
// První řada (i<3) je eager — 2./3. karta na desktopu nesmí vyhrát LCP
// jako lazy. Stejný výpočet jako archiv — lokální WebP, jinak JPG.
const prvniHub = temata[0];
const kartaPreload = prvniHub?.nahled.hasLocalThumb
  ? preloadHeroObrazku({
      src: prvniHub.nahled.localThumb,
      webp: prvniHub.nahled.hasWebp ? prvniHub.nahled.thumbWebp : undefined,
    })
  : null;

const popis = 'Všechna témata REALTECH CZ na jednom místě — AI, drony, vesmír, hardware, mobily a sítě. Tech bez marketingových řečí.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Novinky', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Témata', item: new URL('/temata/', Astro.site).href },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Témata',
  description: popis,
  url: new URL('/temata/', Astro.site).href,
  inLanguage: 'cs',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: temata.length,
    itemListElement: temata.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/temata/${t.slug}/`, Astro.site).href,
      name: t.category,
    })),
  },
};
---
<Base title={seoTitulek('Témata')} ogTitle="Témata | REALTECH CZ" description={popis}>
  {kartaPreload && (
    <link
      rel="preload"
      as="image"
      href={kartaPreload.href}
      type={kartaPreload.type}
      fetchpriority="high"
      slot="head"
    />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} slot="head" is:inline />
  <section class="articles hub">
    <div class="wrap">
      <div class="section-head">
        <h1>Témata</h1>
        <a href="/clanky/">Všechny články →</a>
      </div>
      <p class="cat-lead">{popis}</p>
      <div class="grid temata-hub">
        {temata.map((t, i) => (
          <article class="card" data-category={t.category}>
            {t.nahled.localThumb && (
              <div class={`card-thumb th-${t.slug}`}>
                <picture>
                  {t.nahled.hasWebp && t.nahled.thumbWebpSrcset && (
                    <source srcset={t.nahled.thumbWebpSrcset} sizes="(max-width: 580px) 100vw, (max-width: 900px) 50vw, 33vw" type="image/webp" />
                  )}
                  {t.nahled.hasWebp && !t.nahled.thumbWebpSrcset && (
                    <source srcset={t.nahled.thumbWebp} type="image/webp" />
                  )}
                  <img src={t.nahled.lcpSrc} alt={t.nejnovejsi.data.title} width={t.nahled.thumbW} height={t.nahled.thumbH} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
                </picture>
              </div>
            )}
            <div class="card-body">
              <h2><a href={`/temata/${t.slug}/`}>{t.category}</a></h2>
              <p>{popisTematu(t.category)}</p>
              <div class="card-meta">
                <time datetime={t.nejnovejsi.data.date.toISOString().slice(0, 10)}>{formatCalendarDateCs(t.nejnovejsi.data.date)}</time>
                <span>{pocetClankuText(t.pocet).toUpperCase()}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Náhled je <div>, ne druhý <a>. Stretched link: ::after odkazu
     v titulku pokryje celou kartu včetně fotky. Jediný <a>. */
  .grid .card { position: relative; }
  .card-body h2 a::after,
  .card-body h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
