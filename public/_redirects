# @astrojs/sitemap generuje jen sitemap-index.xml + sitemap-0.xml,
# ale crawleři konvenčně zkoušejí /sitemap.xml — bez redirectu tam byla 404.
/sitemap.xml /sitemap-index.xml 301

# První stránka archivu žije na /clanky/ — /clanky/strana/1/ se negeneruje
# (paginace začíná na strana/2) a vracela 404. Query string Pages zachová samo.
/clanky/strana/1 /clanky/ 301
/clanky/strana/1/ /clanky/ 301

# Stejně u témat: první stránka žije na /temata/{slug}/ a strana/1 se
# negeneruje (paginace témat začíná na strana/2) — bez redirectu 404.
/temata/:slug/strana/1 /temata/:slug/ 301
/temata/:slug/strana/1/ /temata/:slug/ 301

# Feed žije na /rss.xml (rel=alternate v <head>, odkaz v patičce),
# ale čtečky a lidé konvenčně zkoušejí /feed a /rss — bez redirectu tam byla 404.
/feed /rss.xml 301
/feed/ /rss.xml 301
/feed.xml /rss.xml 301
/rss /rss.xml 301
/rss/ /rss.xml 301
/rss.xml/ /rss.xml 301
/atom /rss.xml 301
/atom/ /rss.xml 301
/atom.xml /rss.xml 301

# Vlastní stránka /kontakt neexistuje (kontakt je mailto v patičce),
# ale lidé URL pořád zkoušejí ručně — bez redirectu tam byla 404.
# Kontaktní údaje žijí na /o-nas/.
/kontakt /o-nas/ 301
/kontakt/ /o-nas/ 301

# Anglické hádání stejných stránek: /about → O nás, /blog → archiv.
# Živě 2. 9. 2026 obě vracely 404 (stejný dluh jako /kontakt).
/about /o-nas/ 301
/about/ /o-nas/ 301
/blog /clanky/ 301
/blog/ /clanky/ 301

# Témata žijí pod /temata/{slug}/. Starší tvar /{slug}/ (ai-report,
# hardware, vesmir, …) i /{slug}/strana/2/ živě 28. 8. 2026 vracel 404.
# Jen slugy ze schématu kategorií — /:slug by sekl i /rss.xml.
# Platné strany 2+ (dnes jen AI Report) jdou na stejnou stranu pod /temata/.
# Strana 1 a neexistující N jdou na hub tématu.
